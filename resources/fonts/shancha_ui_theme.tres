[gd_resource type="Theme" load_steps=4 format=3]

[ext_resource type="FontFile" path="res://resources/fonts/BreeSerif-Regular.ttf" id="1_bree_serif"]
[ext_resource type="FontFile" path="res://resources/fonts/zpix.woff2" id="2_zpix"]

[sub_resource type="FontVariation" id="FontVariation_ui"]
