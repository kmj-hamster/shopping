msgid "expedition.ui.enter"
msgstr "Explore the Mall"
msgid "expedition.ui.enter_short"
msgstr "Explore"
msgid "expedition.ui.confirm_enter"
msgstr "Once you leave the courtyard, you will explore two rooms before returning. Go now?"

msgid "expedition.ui.confirm_enter.lethal_white_flower"
msgstr "I already carry three white flowers. If I leave this place, I may be lost beyond return."

msgid "expedition.ui.confirm_enter.lethal_wound"
msgstr "I already carry three wounds. If I leave this place, I may be lost beyond return."
msgid "expedition.ui.door_prompt"
msgstr "The door you choose will decide where you spend the next six hours..."
