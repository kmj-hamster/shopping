msgid "slot.property.reading"
msgstr "Reading"

msgid "slot.property.reading.description"
msgstr "It can be read, consulted, or searched for clues between the lines."

msgid "slot.property.memory"
msgstr "Memory"

msgid "slot.property.memory.description"
msgstr "It can recall a person, place, or feeling from the past."

msgid "slot.property.relaxing"
msgstr "Relaxing"

msgid "slot.property.relaxing.description"
msgstr "It slows a tight breath and an overworked mind."

msgid "slot.property.dreamlike"
msgstr "Dreamlike"

msgid "slot.property.dreamlike.description"
msgstr "The edges of reality loosen around it."

msgid "slot.property.music"
msgstr "Music"

msgid "slot.property.music.description"
msgstr "It contains melody, rhythm, or a sound that has been recorded."

msgid "slot.property.sleep_aid"
msgstr "Sleep Aid"

msgid "slot.property.sleep_aid.description"
msgstr "It helps sleep arrive, or makes the night gentler."

msgid "slot.property.stimulating"
msgstr "Stimulating"

msgid "slot.property.stimulating.description"
msgstr "It brightens awareness and drives away drowsiness."

msgid "slot.property.electric"
msgstr "Electric"

msgid "slot.property.electric.description"
msgstr "Current, fluorescent tubes, or running machinery give it life."

msgid "slot.property.plant"
msgstr "Plant"

msgid "slot.property.plant.description"
msgstr "It is still growing, or still carries the breath of a plant."

msgid "slot.property.warm"
msgstr "Warm"

msgid "slot.property.warm.description"
msgstr "It has a temperature that can be confirmed in the palm."

msgid "slot.property.soft"
msgstr "Soft"

msgid "slot.property.soft.description"
msgstr "It can be pressed, folded, or held without caution."

msgid "slot.property.toy"
msgstr "Toy"

msgid "slot.property.toy.description"
msgstr "It exists for play, companionship, or pretending."

msgid "slot.property.fragile"
msgstr "Fragile"

msgid "slot.property.fragile.description"
msgstr "It breaks easily and asks for gentler movements."

msgid "slot.property.food"
msgstr "Food"

msgid "slot.property.food.description"
msgstr "It can fill the stomach, or only fill a small interval of emptiness."

msgid "slot.property.drink"
msgstr "Drink"

msgid "slot.property.drink.description"
msgstr "It can be swallowed, letting a feeling spread from inside the body."

msgid "slot.property.sweet"
msgstr "Sweet"

msgid "slot.property.sweet.description"
msgstr "It carries sugar and a brief kind of relief."

msgid "slot.property.crispy"
msgstr "Crispy"

msgid "slot.property.crispy.description"
msgstr "It makes a clear, cheerful sound when bitten."

msgid "slot.property.teddy"
msgstr "Teddy"

msgid "slot.property.teddy.description"
msgstr "A bear-shaped companion, skilled at keeping childhood secrets."

msgid "slot.property.alcohol"
msgstr "Alcohol"

msgid "slot.property.alcohol.description"
msgstr "It blunts boundaries and makes certain words easier to say."

