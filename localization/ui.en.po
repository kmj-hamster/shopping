msgid "slot.owner.balloon.name"
msgstr "Mr. Balloon"

msgid "slot.owner.sunflower.name"
msgstr "Mr. Sunflower"

msgid "slot.owner.gramophone.name"
msgstr "Ms. Gramophone"

msgid "slot.owner.magical_girl.name"
msgstr "The Magical Girl"

msgid "slot.owner.mouse.name"
msgstr "Mr. Mouse"

msgid "slot.owner.level.stranger"
msgstr "Stranger"

msgid "slot.owner.level.familiar"
msgstr "Familiar"

msgid "slot.owner.level.wish"
msgstr "A Wish Appears"

msgid "slot.owner.level.friend"
msgstr "Friend"

