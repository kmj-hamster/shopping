msgid "quest.property.reading.name"
msgstr "Reading"
msgid "quest.property.reading.description"
msgstr "Words, pictures, and old dates that can still be read."
msgid "quest.property.music.name"
msgstr "Music"
msgid "quest.property.music.description"
msgstr "A melody or sound that can be played at night."
msgid "quest.property.plant.name"
msgstr "Plant"
msgid "quest.property.plant.description"
msgstr "Something that breathes, grows, or remembers sunlight."
msgid "quest.property.toy.name"
msgstr "Toy"
msgid "quest.property.toy.description"
msgstr "Something once held, wound up, hugged, or forgotten."
msgid "quest.property.food.name"
msgstr "Food"
msgid "quest.property.food.description"
msgstr "Something that can be eaten."
msgid "quest.property.drink.name"
msgstr "Drink"
msgid "quest.property.drink.description"
msgstr "Liquid kept in a cup, bottle, or can."
msgid "quest.property.solvent.name"
msgstr "Solvent"
msgid "quest.property.solvent.description"
msgstr "It removes paint and leaves a smell behind."
msgid "quest.property.gas.name"
msgstr "Gas"
msgid "quest.property.gas.description"
msgstr "Unseen, yet able to make things heavier or lighter."
msgid "quest.property.metal.name"
msgstr "Metal"
msgid "quest.property.metal.description"
msgstr "Cold, rigid, and mindful of the shape of machines."
msgid "quest.property.alcohol.name"
msgstr "Alcohol"
msgid "quest.property.alcohol.description"
msgstr "A drink or scent containing alcohol."
msgid "quest.property.fantasy.name"
msgstr "Fantasy"
msgid "quest.property.fantasy.description"
msgstr "How strongly an unreal thing can become visible."
msgid "quest.property.memory.name"
msgstr "Memory"
msgid "quest.property.memory.description"
msgstr "How strongly an old object pulls you backward."
msgid "quest.property.electric.name"
msgstr "Electric"
msgid "quest.property.electric.description"
msgstr "The force of alternating current, motors, and fluorescent light."
msgid "quest.property.soft.name"
msgstr "Soft"
msgid "quest.property.soft.description"
msgstr "How easily it can cushion, wrap, or be held."
msgid "quest.property.relaxing.name"
msgstr "Relaxing"
msgid "quest.property.relaxing.description"
msgstr "How well it slows your breathing and the room around it."
msgid "quest.property.sweet.name"
msgstr "Sweet"
msgid "quest.property.sweet.description"
msgstr "The concentration of sugar and artificial fruit."
msgid "quest.property.crispy.name"
msgstr "Crispy"
msgid "quest.property.crispy.description"
msgstr "How loudly it can interrupt the radio when bitten."
msgid "quest.property.warm.name"
msgstr "Warm"
msgid "quest.property.warm.description"
msgstr "Heat that lingers in a palm or paper bag."
msgid "quest.property.lamp.name"
msgstr "Lamp"
msgid "quest.property.lamp.description"
msgstr "Alternating current, street corners, and wakeful night walkers."
msgid "quest.property.mirror.name"
msgstr "Mirror"
msgid "quest.property.mirror.description"
msgstr "Still rooms, remembrance, and the sorrow of self-reflection."
msgid "quest.property.candle.name"
msgstr "Candle"
msgid "quest.property.candle.description"
msgstr "Reverie, hallucination, and ancient fish crossing bedroom walls."
msgid "quest.property.pillow.name"
msgstr "Pillow"
msgid "quest.property.pillow.description"
msgstr "Goose down, lavender, and a little comfort before dawn."

msgid "quest.item.book_bedtime_clipping.name"
msgstr "Bedtime Story Clipping"
msgid "quest.item.book_bedtime_clipping.description"
msgstr "The story has no ending. The shopping date on the back remains."
msgid "quest.item.book_aquarium_issue.name"
msgstr "Final Aquarium Issue"
msgid "quest.item.book_aquarium_issue.description"
msgstr "The final issue. Fish keep moving through its faded blue photographs."
msgid "quest.item.book_rapid_eye_manual.name"
msgstr "Rapid Eye Manual"
msgid "quest.item.book_rapid_eye_manual.description"
msgstr "It claims more sleep is not always better. The margins stay awake."
msgid "quest.item.record_lullaby_cassette.name"
msgstr "Second-hand Lullaby Tape"
msgid "quest.item.record_lullaby_cassette.description"
msgstr "Someone coughs softly inside the recording."
msgid "quest.item.record_fluorescent_single.name"
msgstr "Dance Single under Fluorescent Light"
msgid "quest.item.record_fluorescent_single.description"
msgstr "Its beat lingers in the body like the last train."
msgid "quest.item.record_rain_blank_tape.name"
msgstr "Blank Tape with Rain"
msgid "quest.item.record_rain_blank_tape.description"
msgstr "The label says blank. Playback reveals a faraway tide."
msgid "quest.item.flower_sunflower.name"
msgstr "Midnight Sunflower"
msgid "quest.item.flower_sunflower.description"
msgstr "It insists that the mall lights are the sun."
msgid "quest.item.flower_lavender_sachet.name"
msgstr "Lavender Pillow Sachet"
msgid "quest.item.flower_lavender_sachet.description"
msgstr "A small, purple silence that seems to breathe."
msgid "quest.item.flower_night_jasmine.name"
msgstr "Night-blooming Jasmine"
msgid "quest.item.flower_night_jasmine.description"
msgstr "Its scent finds an outline only after the lights go out."
msgid "quest.item.toy_cloth_scraps.name"
msgstr "Old Plush Offcuts"
msgid "quest.item.toy_cloth_scraps.description"
msgstr "Left over from a toy that was never finished."
msgid "quest.item.toy_glass_marble.name"
msgstr "Glass Marble"
msgid "quest.item.toy_glass_marble.description"
msgstr "Light is trapped inside like a school break with no exit."
msgid "quest.item.toy_windup_moth.name"
msgstr "Clockwork Moth"
msgid "quest.item.toy_windup_moth.description"
msgstr "Unable to fly, it walks very carefully along the glass."
msgid "quest.item.toy_model_paint.name"
msgstr "Unlabelled Model Paint"
msgid "quest.item.toy_model_paint.description"
msgstr "The color has settled. The smell remains sharp."
msgid "quest.item.toy_sleeping_rabbit.name"
msgstr "Drowsing Cloth Rabbit"
msgid "quest.item.toy_sleeping_rabbit.description"
msgstr "Its ears droop as if guarding a child's small piece of sleep."
msgid "quest.item.fast_hash_brown.name"
msgstr "Vending-machine Hash Brown"
msgid "quest.item.fast_hash_brown.description"
msgstr "The paper bag is warm. Its crunch is unusually clear."
msgid "quest.item.fast_warm_milk.name"
msgstr "Warm Milk in a Paper Cup"
msgid "quest.item.fast_warm_milk.description"
msgstr "A thin skin of milk cools slowly around the rim."
msgid "quest.item.fast_banana_soda.name"
msgstr "Banana Soda"
msgid "quest.item.fast_banana_soda.description"
msgstr "Sweet like a yellow fruit that never existed."
msgid "quest.item.fast_co2_cylinder.name"
msgstr "Carbon Dioxide Cylinder"
msgid "quest.item.fast_co2_cylinder.description"
msgstr "The old valve still works. The bottle is heavier than it looks."
msgid "quest.item.craft_childhood_teddy.name"
msgstr "Childhood Teddy"
msgid "quest.item.craft_childhood_teddy.description"
msgstr "It knows the bedroom you forgot."
msgid "quest.item.craft_comfort_bear.name"
msgstr "Infant Comfort Bear"
msgid "quest.item.craft_comfort_bear.description"
msgstr "It will not ask why you are still awake."
msgid "quest.item.craft_banana_water.name"
msgstr "Banana Thinner"
msgid "quest.item.craft_banana_water.description"
msgstr "An undrinkable sheen floats inside the sweetness."

msgid "quest.recipe.teddy.name"
msgstr "Teddy Bear"
msgid "quest.recipe.teddy.slot.soft_filling"
msgstr "Something soft to fill it"
msgid "quest.recipe.teddy.slot.toy_shape"
msgstr "Something shaped like a toy"
msgid "quest.recipe.teddy.slot.calm"
msgstr "Something to quiet it"
msgid "quest.recipe.teddy.preview.childhood"
msgstr "It knows the bedroom you forgot."
msgid "quest.recipe.teddy.preview.comfort"
msgstr "It will not ask why you are still awake."
msgid "quest.recipe.banana_water.name"
msgstr "Banana Thinner"
msgid "quest.recipe.banana_water.slot.sweet_liquid"
msgstr "An excessively sweet liquid"
msgid "quest.recipe.banana_water.slot.solvent"
msgstr "Something that removes color"
msgid "quest.recipe.banana_water.preview"
msgstr "An undrinkable sheen rises through the sweetness."

msgid "quest.task.order_hamster.name"
msgstr "A Midnight Snack for Hamster House"
msgid "quest.task.order_hamster.body"
msgstr "Their warehouse lights are still on. They need something edible at night."
msgid "quest.task.order_hamster.slot"
msgstr "Something to eat at night"
msgid "quest.task.order_hamster.result.awake"
msgstr "The hash brown rustles. Hamster House decides to finish inventory tonight."
msgid "quest.task.order_hamster.result.sleep"
msgstr "The milk arrives lukewarm. The night crew tucks a blanket over the time clock."
msgid "quest.task.order_hamster.result.plain"
msgstr "The snack arrives on time. Tiny pawprints remain on the receipt."

msgid "quest.task.order_broadcast.name"
msgstr "Riverside Night Radio Request"
msgid "quest.task.order_broadcast.body"
msgstr "The night program needs a sound to fill the gaps between traffic reports."
msgid "quest.task.order_broadcast.slot"
msgstr "A sound that can be played at night"
msgid "quest.task.order_broadcast.result.street"
msgstr "The beat slips between traffic reports. The city taps its foot at a red light."
msgid "quest.task.order_broadcast.result.tide"
msgstr "The host falls silent. A tide crosses the empty frequency, far from any sea."
msgid "quest.task.order_broadcast.result.memory"
msgstr "Someone coughs on the tape. Three listeners call to say they know that voice."
msgid "quest.task.order_broadcast.result.plain"
msgstr "The program airs on time. The sound crosses the river without an echo."

msgid "quest.task.order_birthday.name"
msgstr "A Birthday at Lost and Found"
msgid "quest.task.order_birthday.body"
msgstr "The clerk wants a birthday gift for a name no one has claimed."
msgid "quest.task.order_birthday.slot"
msgstr "A toy that can be held or remembered"
msgid "quest.task.order_birthday.result.remembered"
msgstr "The same scratches appear in an old ledger. The gift goes to a renamed address."
msgid "quest.task.order_birthday.result.comfort"
msgstr "No one claims it. The clerk leaves it with a sleeping child in the waiting room."
msgid "quest.task.order_birthday.result.plain"
msgstr "The gift enters a lost-property locker. By morning, the door is open."

msgid "quest.task.order_window.name"
msgstr "The Window without Sun"
msgid "quest.task.order_window.body"
msgstr "The office window glows all night but never sees the sun."
msgid "quest.task.order_window.slot"
msgstr "A plant that can remain at night"
msgid "quest.task.order_window.result.false_sun"
msgstr "The flower turns to a ceiling lamp. Everyone by the window stays up an hour later."
msgid "quest.task.order_window.result.night_forest"
msgstr "After lights-out, endless branches appear behind the glass."
msgid "quest.task.order_window.result.rest"
msgstr "The scent rests in the window frame. For once, no lamp burns until dawn."
msgid "quest.task.order_window.result.plain"
msgstr "The plant survives on a sunless windowsill. For now."

msgid "quest.task.care_hungry.name"
msgstr "Hungry"
msgid "quest.task.care_hungry.body"
msgstr "Before shopping, decide what might fill you tonight."
msgid "quest.task.care_hungry.slot"
msgstr "Something for yourself to eat"
msgid "quest.task.care_hungry.result.hash_brown"
msgstr "The crunch is clearer than the hourly radio signal."
msgid "quest.task.care_hungry.result.warm_milk"
msgstr "Milk cools around the rim. You decide this counts as supper."
msgid "quest.task.care_hungry.result.plain"
msgstr "Before the mall goes dark, you keep a little something for yourself."
msgid "quest.task.care_sleepless.name"
msgstr "Not Ready to Sleep"
msgid "quest.task.care_sleepless.body"
msgstr "The night has only just become yours. It need not end yet."
msgid "quest.task.care_sleepless.slot"
msgstr "Something to stay awake with"
msgid "quest.task.care_sleepless.result.plain"
msgstr "There is another sound in the room. Sleep cannot find the door."
msgid "quest.task.care_bedside.name"
msgstr "Something by the Bed"
msgid "quest.task.care_bedside.body"
msgstr "A small place by the bed waits for something you bring home tonight."
msgid "quest.task.care_bedside.slot"
msgstr "A plant for the night"
msgid "quest.task.care_bedside.result.sunflower"
msgstr "The flower faces the ceiling lamp, mistaking it for the sun."
msgid "quest.task.care_bedside.result.jasmine"
msgstr "Only after lights-out does the fragrance find its outline."
msgid "quest.task.care_bedside.result.lavender"
msgstr "A small, purple silence begins breathing beside the pillow."
msgid "quest.task.care_bedside.result.plain"
msgstr "The plant spends the night quietly beside the bed."
msgid "quest.task.care_rain.name"
msgstr "The Rain Is Too Close"
msgid "quest.task.care_rain.body"
msgstr "Rain presses against the window. You want something between it and you."
msgid "quest.task.care_rain.slot"
msgstr "Something soft or warm"
msgid "quest.task.care_rain.result.plain"
msgstr "Rain continues, but its sound retreats beyond something soft."

msgid "quest.task.owner_balloon.name"
msgstr "Erase the Smile"
msgid "quest.task.owner_balloon.body"
msgstr "Mr. Balloon wants to erase his printed smile, or stop himself from floating away."
msgid "quest.task.owner_balloon.slot"
msgstr "Only one answer can be given"
msgid "quest.task.owner_balloon.result.flight"
msgstr "The smile fades. He rises past the sign and softly touches the ceiling."
msgid "quest.task.owner_balloon.result.ground"
msgstr "His shoes meet the floor completely. The smile remains, but no longer strains."

msgid "quest.owner.balloon.name"
msgstr "Mr. Balloon"
msgid "quest.owner.balloon.idle"
msgstr "Mr. Balloon folds his gloves on the counter. His printed smile does not move."
msgid "quest.owner.balloon.item_comment"
msgstr "“%s.” He taps the price tag. “It has waited here longer than I have.”"
msgid "quest.owner.balloon.request"
msgstr "“Banana solvent might erase a smile. Heavier air might keep me here.”"
msgid "quest.owner.balloon.reminder"
msgstr "Mr. Balloon holds down his smile, waiting for you to bring back one answer."
msgid "quest.owner.balloon.departed"
msgstr "A string hangs behind the counter. There is no balloon at its end."
msgid "quest.owner.balloon.grounded"
msgstr "Mr. Balloon sits on a folding chair, both shoes resting firmly on the floor."

msgid "quest.owner.sunflower.name"
msgstr "Mr. Sunflower"
msgid "quest.owner.sunflower.idle"
msgstr "Mr. Sunflower says nothing. His petals turn slightly toward the damp light."
msgid "quest.owner.sunflower.item_comment"
msgstr "He moves %s nearer the lamp. His petals make a faint papery sound."

msgid "quest.owner.mouse.name"
msgstr "Mr. Mouse"
msgid "quest.owner.mouse.idle"
msgstr "The mouse costume waves. Only the vending machines hum in the kitchen."
msgid "quest.owner.mouse.item_comment"
msgstr "“%s! Eat it at night and the flavor gets a little more serious.”"

msgid "quest.owner.gramophone.name"
msgstr "Madam Gramophone"
msgid "quest.owner.gramophone.idle"
msgstr "Madam Gramophone polishes the needle and pretends not to notice you."
msgid "quest.owner.gramophone.item_comment"
msgstr "“%s. Records remember. Prices do not.”"

msgid "quest.owner.magical_girl.name"
msgstr "Magical Girl"
msgid "quest.owner.magical_girl.idle"
msgstr "The magical girl peers over a stack of books as if she has waited all night."
msgid "quest.owner.magical_girl.item_comment"
msgstr "“%s. Do not trust the cover; the night inside is longer.”"

msgid "quest.store_unlock.record.slot"
msgstr "Moth-shaped recess"
msgid "quest.store_unlock.record.prompt"
msgstr "A moth-shaped piece is missing from the shutter."
msgid "quest.store_unlock.record.result"
msgstr "The clockwork moth circles the seam. The shutter rises."
msgid "quest.store_unlock.book.slot"
msgstr "Center of the paper sun"
msgid "quest.store_unlock.book.prompt"
msgstr "The papier-mâché sun is missing its center."
msgid "quest.store_unlock.book.result"
msgstr "The sunflower completes it. A daylight-colored lamp wakes inside."

msgid "quest.ui.hand.title"
msgstr "Things in hand"
msgid "quest.ui.hand.empty"
msgstr "The paper bag feels light."
msgid "quest.ui.back"
msgstr "Back"
msgid "quest.ui.money"
msgstr "◇ %d"
msgid "quest.ui.day_money"
msgstr "Night %d  ·  ◇ %d"
msgid "quest.ui.next_day"
msgstr "Next night"
msgid "quest.ui.next_day.confirm_title"
msgstr "Leave the mall?"
msgid "quest.ui.next_day.confirm_body"
msgstr "Leave now. Confirmed tasks settle during the interlude; everything else waits for another night."
msgid "quest.ui.next_day.confirm"
msgstr "Leave"
msgid "quest.ui.cancel"
msgstr "Stay a while"
msgid "quest.ui.map.locked"
msgstr "Locked"
msgid "quest.ui.shop.shelf"
msgstr "Shelf"
msgid "quest.ui.shop.sold"
msgstr "Empty"
msgid "quest.ui.shop.checkout"
msgstr "Checkout  ◇%d"
msgid "quest.ui.shop.done"
msgstr "The items settle into your paper bag."
msgid "quest.ui.shop.no_money"
msgstr "Not enough money."
msgid "quest.ui.shop.empty"
msgstr "Nothing is selected yet."
msgid "quest.ui.shop.page_locked"
msgstr "This page has not been opened yet."
msgid "quest.ui.owner.talk"
msgstr "Talk"
msgid "quest.ui.owner.none"
msgstr "Unattended"
msgid "quest.ui.recycle.hint"
msgstr "Drag unwanted cards here. The counter returns their actual purchase price."
msgid "quest.ui.recycle.checkout"
msgstr "Return  %d / ◇%d"
msgid "quest.ui.recycle.done"
msgstr "The items vanish behind the counter. The coins return to your hand."
msgid "quest.ui.arc.night"
msgstr "Night %d · Deliveries"
msgid "quest.ui.arc.empty"
msgstr "There are no parcels to deliver tonight. The mall lights go out behind you, one by one."
msgid "quest.ui.arc.new_day"
msgstr "Night %d"
msgid "quest.ui.task.slot.ready"
msgstr "Suitable"
msgid "quest.ui.task.slot.weak"
msgstr "Not enough"
msgid "quest.ui.task.confirm"
msgstr "Confirm"
msgid "quest.ui.task.deliver_tomorrow"
msgstr "Deliver tomorrow"
msgid "quest.ui.task.enjoy_tonight"
msgstr "Enjoy at home tonight"
msgid "quest.ui.task.cancel_confirm"
msgstr "Unconfirm"
msgid "quest.ui.task.confirmed"
msgstr "Packed. It will settle when you leave the mall."
msgid "quest.ui.task.not_ready"
msgstr "It fits, but its strength is not enough."
msgid "quest.ui.task.deliver"
msgstr "Give to owner"
msgid "quest.ui.task.owner_elsewhere"
msgstr "This must be delivered at the owner's shop."
msgid "quest.ui.synthesis.open"
msgstr "Enter the Colors Within"
msgid "quest.ui.synthesis.title"
msgstr "Colors Within the Bag"
msgid "quest.ui.synthesis.unknown"
msgstr "An unnamed shape"
msgid "quest.ui.synthesis.hint"
msgstr "Place a few things together. They may remember another shape."
msgid "quest.ui.synthesis.working"
msgstr "Something rustles softly in the bottom of the bag…"
msgid "quest.ui.synthesis.action"
msgstr "Combine"
msgid "quest.ui.synthesis.known_hint"
msgstr "Someone has hinted at this shape."
msgid "quest.ui.synthesis.unknown_hint"
msgstr "This recipe does not have a name yet."
msgid "demo.property.food.name"
msgstr "Food"
msgid "demo.property.food.description"
msgstr "Something that can be eaten."
msgid "demo.property.salty.name"
msgstr "Salty"
msgid "demo.property.salty.description"
msgstr "The distinct taste left by salt."
msgid "demo.property.plant.name"
msgstr "Plant"
msgid "demo.property.plant.description"
msgstr "Something still growing, or still remembering sunlight."
msgid "demo.property.drink.name"
msgstr "Drink"
msgid "demo.property.drink.description"
msgstr "Liquid kept in a bottle, cup, or can."
msgid "demo.property.metal.name"
msgstr "Metal"
msgid "demo.property.metal.description"
msgstr "Cold, hard, and shaped by machines."
msgid "demo.property.tool.name"
msgstr "Tool"
msgid "demo.property.tool.description"
msgstr "Something made to change other things."
msgid "demo.property.lamp.name"
msgstr "Lamp"
msgid "demo.property.lamp.description"
msgstr "An influence that illuminates what does not exist."
msgid "demo.property.mirror.name"
msgstr "Mirror"
msgid "demo.property.mirror.description"
msgstr "An influence that recalls the outline of the past."
msgid "demo.stat.fantasy.name"
msgstr "Fantasy"
msgid "demo.stat.fantasy.description"
msgstr "Makes nonexistent things briefly visible."
msgid "demo.stat.memory.name"
msgstr "Memory"
msgid "demo.stat.memory.description"
msgstr "Draws you back through old objects."
msgid "demo.stat.electric.name"
msgstr "Electricity"
msgid "demo.stat.electric.description"
msgstr "The influence of motors, current, and fluorescent light."
msgid "demo.stat.soft.name"
msgstr "Softness"
msgid "demo.stat.soft.description"
msgstr "The feeling of sinking in, being wrapped, or being held."

msgid "demo.item.fries.name"
msgstr "Fries"
msgid "demo.item.fries.description"
msgstr "Crisp-fried, with grains of salt at the bottom of the packet."
msgid "demo.item.sunflower.name"
msgstr "Sunflower"
msgid "demo.item.sunflower.description"
msgstr "A sunflower at night, blooming for everything out of place."
msgid "demo.item.agave.name"
msgstr "Agave"
msgid "demo.item.agave.description"
msgstr "Its thick leaves hold the night's moisture."
msgid "demo.item.cola.name"
msgstr "Cola"
msgid "demo.item.cola.description"
msgstr "They say it tastes best from a glass bottle."
msgid "demo.item.scissors.name"
msgstr "Scissors"
msgid "demo.item.scissors.description"
msgstr "Cold metal scissors that make a clean snip as they close."

msgid "demo.store.flower.name"
msgstr "Flower Shop"
msgid "demo.store.record.name"
msgstr "Record Shop"
msgid "demo.owner.flower.name"
msgstr "Mr. Sunflower"
msgid "demo.owner.flower.idle"
msgstr "Welcome..."
msgid "demo.owner.flower.item_comment"
msgstr "Want to see... %s..."
msgid "demo.owner.flower.request"
msgstr "..."
msgid "demo.owner.flower.reminder"
msgstr "He points again at the tiny white flowers on his stem."
msgid "demo.owner.flower.state.trimmed"
msgstr "The tiny white flowers are gone."
msgid "demo.owner.flower.state.blooming"
msgstr "The white flowers drank deeply and kept blooming through the night."
msgid "demo.owner.record.name"
msgstr "Record Shop Owner"
msgid "demo.owner.record.idle"
msgstr "I've never seen you before... What do you want?"
msgid "demo.owner.record.item_comment"
msgstr "Keep that %s away from me."

msgid "demo.unlock.record.slot"
msgstr "Someone carrying flowers"
msgid "demo.unlock.record.prompt"
msgstr "A gramophone silhouette shows through red velvet curtains. They say the owner has no patience for people—except those carrying flowers."
msgid "demo.unlock.record.result"
msgstr "The record shop is now open."

msgid "demo.recipe.scissors.name"
msgstr "Scissors"
msgid "demo.recipe.scissors.slot.metal"
msgstr "Metal material"
msgid "demo.recipe.scissors.slot.lamp"
msgstr "Lamp influence"
msgid "demo.recipe.scissors.preview"
msgstr "Snip, snip, snip—【Metal, tempered by Lamp, can become scissors.】"

msgid "demo.property.flower.name"
msgstr "Flower"

msgid "demo.property.flower.description"
msgstr "Something that blooms, withers, and leaves a scent behind."

msgid "demo.property.toy.name"
msgstr "Toy"

msgid "demo.property.toy.description"
msgstr "Something made for play or companionship."

msgid "demo.property.rose.name"
msgstr "Rose"

msgid "demo.property.rose.description"
msgstr "A flower that has never grown inside Concrete City."

msgid "demo.property.teddy_bear.name"
msgstr "Teddy Bear"

msgid "demo.property.teddy_bear.description"
msgstr "The particular outline left by a bear-shaped toy."

msgid "demo.property.gauze.name"
msgstr "Gauze"

msgid "demo.property.gauze.description"
msgstr "An aspect that gives distant imaginings a thin outline."

msgid "demo.property.pillow.name"
msgstr "Pillow"

msgid "demo.property.pillow.description"
msgstr "An aspect that makes things soft, settled, and safe to lean on."

msgid "demo.persona.ease.name"
msgstr "Ease"

msgid "demo.persona.ease.description"
msgstr "Your understanding of rest and being held. It provides only Pillow."

msgid "demo.persona.reverie.name"
msgstr "Reverie"

msgid "demo.persona.reverie.description"
msgstr "The imagination with which you shape what does not exist. It provides only Gauze."

msgid "demo.persona.reminiscence.name"
msgstr "Reminiscence"

msgid "demo.persona.reminiscence.description"
msgstr "Your ability to see the past inside old things. It provides only Mirror."

msgid "demo.persona.clarity.name"
msgstr "Clarity"

msgid "demo.persona.clarity.description"
msgstr "Your ability to illuminate and recognize an outline. It provides only Lamp."

msgid "demo.item.toy_block.name"
msgstr "Old Building Block"

msgid "demo.item.toy_block.description"
msgstr "A faded wooden block that still counts as a toy."

msgid "demo.item.midnight_rose.name"
msgstr "Midnight Rose"

msgid "demo.item.midnight_rose.description"
msgstr "A rose that does not exist in Concrete City. Its petals resemble a piece of remembered midnight."

msgid "demo.item.worn_teddy.name"
msgstr "Worn Teddy Bear"

msgid "demo.item.worn_teddy.description"
msgstr "Its worn patches make it seem as if someone held it for years."

msgid "demo.item.baby_teddy.name"
msgstr "Baby Comfort Bear"

msgid "demo.item.baby_teddy.description"
msgstr "Soft enough to catch a cry and remain through a very long sleep."

msgid "demo.item.pale_teddy.name"
msgstr "Pale Teddy Bear"

msgid "demo.item.pale_teddy.description"
msgstr "Its color stayed on the far side of the mirror, leaving a quiet pale toy."

msgid "demo.item.soft_gauze.name"
msgstr "Soft Gauze"

msgid "demo.item.soft_gauze.description"
msgstr "A soft scrap carrying Gauze 2 and Pillow 2, useful as fuel that provides aspects in synthesis."

msgid "demo.item.mirror_shard.name"
msgstr "Old Mirror Shard"

msgid "demo.item.mirror_shard.description"
msgstr "An old shard carrying Mirror 2 and Lamp 2, useful as fuel that provides aspects in synthesis."

msgid "demo.recipe.base.flower"
msgstr "Any flower"

msgid "demo.recipe.base.toy"
msgstr "Any toy"

msgid "demo.recipe.base.worn_teddy"
msgstr "Worn Teddy Bear"

msgid "demo.recipe.midnight_rose.name"
msgstr "Midnight Rose"

msgid "demo.recipe.worn_teddy.name"
msgstr "Worn Teddy Bear"

msgid "demo.recipe.baby_teddy.name"
msgstr "Baby Comfort Bear"

msgid "demo.recipe.pale_teddy.name"
msgstr "Pale Teddy Bear"

msgid "demo.recipe.midnight_rose.process.1"
msgstr "You remember a flower that has never bloomed in Concrete City."

msgid "demo.recipe.midnight_rose.process.2"
msgstr "Gauze wraps that nonexistent memory around a set of petals."

msgid "demo.recipe.midnight_rose.process.3"
msgstr "The color of midnight slowly acquires a scent."

msgid "demo.recipe.worn_teddy.process.1"
msgstr "The toy's hard corners soften in your palm."

msgid "demo.recipe.worn_teddy.process.2"
msgstr "Pillow fills it with time that has already been held."

msgid "demo.recipe.worn_teddy.process.3"
msgstr "Wear appears on it before memory does."

msgid "demo.recipe.baby_teddy.process.1"
msgstr "Old stuffing becomes full again."

msgid "demo.recipe.baby_teddy.process.2"
msgstr "Pillow teaches every seam how to comfort."

msgid "demo.recipe.baby_teddy.process.3"
msgstr "It waits quietly for the next cry."

msgid "demo.recipe.pale_teddy.process.1"
msgstr "The mirror draws the color out of the toy."

msgid "demo.recipe.pale_teddy.process.2"
msgstr "Its old outline becomes clearer inside the pallor."

msgid "demo.recipe.pale_teddy.process.3"
msgstr "It opens its eyes from inside the reflection."

msgid "demo.recipe.scissors.process.1"
msgstr "Metal reveals a sharp outline beneath the lamp."

msgid "demo.recipe.scissors.process.2"
msgstr "Two thin blades bite together in your imagination."

msgid "demo.ui.synthesis.base"
msgstr "Material"

msgid "demo.ui.synthesis.base.description"
msgstr "I need one definite object on which to impose imagination. [The material provides all of its properties.]"

msgid "demo.ui.synthesis.fuel"
msgstr "Fuel"

msgid "demo.ui.synthesis.fuel.description"
msgstr "Something to make my imagination burn brighter, temporarily. [Fuel provides aspects only and will be consumed.]"

msgid "demo.ui.synthesis.mask"
msgstr "Mask"

msgid "demo.ui.synthesis.mask.description"
msgstr "What kind of resident of the night are you? [Provides an aspect and will not be consumed.]"

msgid "quest.ui.hand.items"
msgstr "Items"

msgid "quest.ui.hand.masks"
msgstr "Masks"

msgid "demo.property.persona.name"
msgstr "Persona"

msgid "demo.property.persona.description"
msgstr "A mask that names the shape you take in the night."

msgid "demo.mask.nightwalker.name"
msgstr "The Nightwalker"

msgid "demo.mask.nightwalker.description"
msgstr "A mask for one who follows lamplight through the long night."

msgid "demo.mask.mourner.name"
msgstr "The Mourner"

msgid "demo.mask.mourner.description"
msgstr "A mask for one who keeps watch over what was lost in the mirror."

msgid "demo.mask.dreamwalker.name"
msgstr "The Dreamwalker"

msgid "demo.mask.dreamwalker.description"
msgstr "A mask for one who walks into imagination through gauze."

msgid "demo.mask.homecomer.name"
msgstr "The Homecomer"

msgid "demo.mask.homecomer.description"
msgstr "A mask for one whom weariness guides home."

msgid "demo.ui.synthesis.candidates"
msgstr "Possible Shapes"

msgid "demo.ui.synthesis.no_candidates"
msgstr "No shape appears inside the bag"

msgid "demo.ui.synthesis.totals"
msgstr "Properties in the Bag"

msgid "demo.ui.synthesis.personas"
msgstr "Choose One Persona"

msgid "demo.ui.synthesis.unknown_candidate"
msgstr "???"

msgid "demo.ui.synthesis.flip_result"
msgstr "Click to reveal"

msgid "demo.ui.synthesis.drag_result"
msgstr "Drag into hand"

msgid "demo.task.girl.name"
msgstr "The Little Girl's Request"
msgid "demo.task.girl.body"
msgstr "Dear shopper: All they have brought me lately is cabbage, and I have had enough. Please bring me something to eat—anything! (Something salty would be best.)"
msgid "demo.task.girl.slot"
msgstr "Something edible"
msgid "demo.task.girl.result.salty"
msgstr "The girl in the fish tank raved about your fries and asked you to bring ketchup next time."
msgid "demo.task.girl.result.plain"
msgstr "The girl in the fish tank accepted the food you brought."
msgid "demo.task.self_care.name"
msgstr "Take Care of Yourself"
msgid "demo.task.self_care.body"
msgstr "Bring yourself something to drink tonight."
msgid "demo.task.self_care.slot"
msgstr "A drink"
msgid "demo.task.self_care.result"
msgstr "Fresh lemon, the scent of alcohol—you fall asleep to the crackle of bubbles."
msgid "demo.task.mouse.name"
msgstr "The Mouse's Request"
msgid "demo.task.mouse.body"
msgstr "The note contains only the outline of a leaf."
msgid "demo.task.mouse.slot"
msgstr "A plant"
msgid "demo.task.mouse.result"
msgstr "The mouse took the plant and quickly vanished into the mall's shadows."
msgid "demo.task.flower_owner.name"
msgstr "The Florist's Request"
msgid "demo.task.flower_owner.body"
msgstr "Mr. Sunflower says nothing. He only points at his neck—or rather, his green stem. Tiny white flowers are growing there. Does he want them cut away, or left to flourish?"
msgid "demo.task.flower_owner.slot.trim"
msgstr "To stop the white flowers growing, I can give him a cold tool."
msgid "demo.task.flower_owner.slot.nourish"
msgstr "To help the white flowers flourish, I can give him a nourishing drink."
msgid "demo.task.flower_owner.result.trimmed"
msgstr "The scissors close, and the tiny white flowers fall into an apron pocket."
msgid "demo.task.flower_owner.result.blooming"
msgstr "The white flowers drink deeply and keep growing in the nighttime shop."
