msgid "quest.property.reading.name"
msgstr "Reading"
msgid "quest.property.reading.description"
msgstr "Words, pictures, and old dates that can still be read."
msgid "quest.property.music.name"
msgstr "Music"
msgid "quest.property.music.description"
msgstr "A melody or sound that can be played at night."
msgid "quest.property.plant.name"
msgstr "Plant"
msgid "quest.property.plant.description"
msgstr "Something that breathes, grows, or remembers sunlight."
msgid "quest.property.toy.name"
msgstr "Toy"
msgid "quest.property.toy.description"
msgstr "Something once held, wound up, hugged, or forgotten."
msgid "quest.property.food.name"
msgstr "Food"
msgid "quest.property.food.description"
msgstr "Something that can be eaten."
msgid "quest.property.drink.name"
msgstr "Drink"
msgid "quest.property.drink.description"
msgstr "Liquid kept in a cup, bottle, or can."
msgid "quest.property.solvent.name"
msgstr "Solvent"
msgid "quest.property.solvent.description"
msgstr "It removes paint and leaves a smell behind."
msgid "quest.property.gas.name"
msgstr "Gas"
msgid "quest.property.gas.description"
msgstr "Unseen, yet able to make things heavier or lighter."
msgid "quest.property.metal.name"
msgstr "Metal"
msgid "quest.property.metal.description"
msgstr "Cold, rigid, and mindful of the shape of machines."
msgid "quest.property.alcohol.name"
msgstr "Alcohol"
msgid "quest.property.alcohol.description"
msgstr "A drink or scent containing alcohol."
msgid "quest.property.fantasy.name"
msgstr "Fantasy"
msgid "quest.property.fantasy.description"
msgstr "How strongly an unreal thing can become visible."
msgid "quest.property.memory.name"
msgstr "Memory"
msgid "quest.property.memory.description"
msgstr "How strongly an old object pulls you backward."
msgid "quest.property.electric.name"
msgstr "Electric"
msgid "quest.property.electric.description"
msgstr "The force of alternating current, motors, and fluorescent light."
msgid "quest.property.soft.name"
msgstr "Soft"
msgid "quest.property.soft.description"
msgstr "How easily it can cushion, wrap, or be held."
msgid "quest.property.relaxing.name"
msgstr "Relaxing"
msgid "quest.property.relaxing.description"
msgstr "How well it slows your breathing and the room around it."
msgid "quest.property.sweet.name"
msgstr "Sweet"
msgid "quest.property.sweet.description"
msgstr "The concentration of sugar and artificial fruit."
msgid "quest.property.crispy.name"
msgstr "Crispy"
msgid "quest.property.crispy.description"
msgstr "How loudly it can interrupt the radio when bitten."
msgid "quest.property.warm.name"
msgstr "Warm"
msgid "quest.property.warm.description"
msgstr "Heat that lingers in a palm or paper bag."
msgid "quest.item.book_bedtime_clipping.name"
msgstr "Bedtime Story Clipping"
msgid "quest.item.book_bedtime_clipping.description"
msgstr "The story has no ending. The shopping date on the back remains."
msgid "quest.item.book_aquarium_issue.name"
msgstr "Final Aquarium Issue"
msgid "quest.item.book_aquarium_issue.description"
msgstr "The final issue. Fish keep moving through its faded blue photographs."
msgid "quest.item.book_rapid_eye_manual.name"
msgstr "Rapid Eye Manual"
msgid "quest.item.book_rapid_eye_manual.description"
msgstr "It claims more sleep is not always better. The margins stay awake."
msgid "quest.item.record_lullaby_cassette.name"
msgstr "Second-hand Lullaby Tape"
msgid "quest.item.record_lullaby_cassette.description"
msgstr "Someone coughs softly inside the recording."
msgid "quest.item.record_fluorescent_single.name"
msgstr "Dance Single under Fluorescent Light"
msgid "quest.item.record_fluorescent_single.description"
msgstr "Its beat lingers in the body like the last train."
msgid "quest.item.record_rain_blank_tape.name"
msgstr "Blank Tape with Rain"
msgid "quest.item.record_rain_blank_tape.description"
msgstr "The label says blank. Playback reveals a faraway tide."
msgid "quest.item.flower_sunflower.name"
msgstr "Midnight Sunflower"
msgid "quest.item.flower_sunflower.description"
msgstr "It insists that the mall lights are the sun."
msgid "quest.item.flower_lavender_sachet.name"
msgstr "Lavender Pillow Sachet"
msgid "quest.item.flower_lavender_sachet.description"
msgstr "A small, purple silence that seems to breathe."
msgid "quest.item.flower_night_jasmine.name"
msgstr "Night-blooming Jasmine"
msgid "quest.item.flower_night_jasmine.description"
msgstr "Its scent finds an outline only after the lights go out."
msgid "quest.item.toy_cloth_scraps.name"
msgstr "Old Plush Offcuts"
msgid "quest.item.toy_cloth_scraps.description"
msgstr "Left over from a toy that was never finished."
msgid "quest.item.toy_glass_marble.name"
msgstr "Glass Marble"
msgid "quest.item.toy_glass_marble.description"
msgstr "Light is trapped inside like a school break with no exit."
msgid "quest.item.toy_windup_moth.name"
msgstr "Clockwork Moth"
msgid "quest.item.toy_windup_moth.description"
msgstr "Unable to fly, it walks very carefully along the glass."
msgid "quest.item.toy_model_paint.name"
msgstr "Unlabelled Model Paint"
msgid "quest.item.toy_model_paint.description"
msgstr "The color has settled. The smell remains sharp."
msgid "quest.item.toy_sleeping_rabbit.name"
msgstr "Drowsing Cloth Rabbit"
msgid "quest.item.toy_sleeping_rabbit.description"
msgstr "Its ears droop as if guarding a child's small piece of sleep."
msgid "quest.item.fast_hash_brown.name"
msgstr "Vending-machine Hash Brown"
msgid "quest.item.fast_hash_brown.description"
msgstr "The paper bag is warm. Its crunch is unusually clear."
msgid "quest.item.fast_warm_milk.name"
msgstr "Warm Milk in a Paper Cup"
msgid "quest.item.fast_warm_milk.description"
msgstr "A thin skin of milk cools slowly around the rim."
msgid "quest.item.fast_banana_soda.name"
msgstr "Banana Soda"
msgid "quest.item.fast_banana_soda.description"
msgstr "Sweet like a yellow fruit that never existed."
msgid "quest.item.fast_co2_cylinder.name"
msgstr "Carbon Dioxide Cylinder"
msgid "quest.item.fast_co2_cylinder.description"
msgstr "The old valve still works. The bottle is heavier than it looks."
msgid "quest.item.craft_childhood_teddy.name"
msgstr "Childhood Teddy"
msgid "quest.item.craft_childhood_teddy.description"
msgstr "It knows the bedroom you forgot."
msgid "quest.item.craft_comfort_bear.name"
msgstr "Infant Comfort Bear"
msgid "quest.item.craft_comfort_bear.description"
msgstr "It will not ask why you are still awake."
msgid "quest.item.craft_banana_water.name"
msgstr "Banana Thinner"
msgid "quest.item.craft_banana_water.description"
msgstr "An undrinkable sheen floats inside the sweetness."

msgid "quest.recipe.teddy.name"
msgstr "Teddy Bear"
msgid "quest.recipe.teddy.slot.soft_filling"
msgstr "Something soft to fill it"
msgid "quest.recipe.teddy.slot.toy_shape"
msgstr "Something shaped like a toy"
msgid "quest.recipe.teddy.slot.calm"
msgstr "Something to quiet it"
msgid "quest.recipe.teddy.preview.childhood"
msgstr "It knows the bedroom you forgot."
msgid "quest.recipe.teddy.preview.comfort"
msgstr "It will not ask why you are still awake."
msgid "quest.recipe.banana_water.name"
msgstr "Banana Thinner"
msgid "quest.recipe.banana_water.slot.sweet_liquid"
msgstr "An excessively sweet liquid"
msgid "quest.recipe.banana_water.slot.solvent"
msgstr "Something that removes color"
msgid "quest.recipe.banana_water.preview"
msgstr "An undrinkable sheen rises through the sweetness."

msgid "quest.task.order_hamster.name"
msgstr "A Midnight Snack for Hamster House"
msgid "quest.task.order_hamster.body"
msgstr "Their warehouse lights are still on. They need something edible at night."
msgid "quest.task.order_hamster.slot"
msgstr "Something to eat at night"
msgid "quest.task.order_hamster.result.awake"
msgstr "The hash brown rustles. Hamster House decides to finish inventory tonight."
msgid "quest.task.order_hamster.result.sleep"
msgstr "The milk arrives lukewarm. The night crew tucks a blanket over the time clock."
msgid "quest.task.order_hamster.result.plain"
msgstr "The snack arrives on time. Tiny pawprints remain on the receipt."

msgid "quest.task.order_broadcast.name"
msgstr "Riverside Night Radio Request"
msgid "quest.task.order_broadcast.body"
msgstr "The night program needs a sound to fill the gaps between traffic reports."
msgid "quest.task.order_broadcast.slot"
msgstr "A sound that can be played at night"
msgid "quest.task.order_broadcast.result.street"
msgstr "The beat slips between traffic reports. The city taps its foot at a red light."
msgid "quest.task.order_broadcast.result.tide"
msgstr "The host falls silent. A tide crosses the empty frequency, far from any sea."
msgid "quest.task.order_broadcast.result.memory"
msgstr "Someone coughs on the tape. Three listeners call to say they know that voice."
msgid "quest.task.order_broadcast.result.plain"
msgstr "The program airs on time. The sound crosses the river without an echo."

msgid "quest.task.order_birthday.name"
msgstr "A Birthday at Lost and Found"
msgid "quest.task.order_birthday.body"
msgstr "The clerk wants a birthday gift for a name no one has claimed."
msgid "quest.task.order_birthday.slot"
msgstr "A toy that can be held or remembered"
msgid "quest.task.order_birthday.result.remembered"
msgstr "The same scratches appear in an old ledger. The gift goes to a renamed address."
msgid "quest.task.order_birthday.result.comfort"
msgstr "No one claims it. The clerk leaves it with a sleeping child in the waiting room."
msgid "quest.task.order_birthday.result.plain"
msgstr "The gift enters a lost-property locker. By morning, the door is open."

msgid "quest.task.order_window.name"
msgstr "The Window without Sun"
msgid "quest.task.order_window.body"
msgstr "The office window glows all night but never sees the sun."
msgid "quest.task.order_window.slot"
msgstr "A plant that can remain at night"
msgid "quest.task.order_window.result.false_sun"
msgstr "The flower turns to a ceiling lamp. Everyone by the window stays up an hour later."
msgid "quest.task.order_window.result.night_forest"
msgstr "After lights-out, endless branches appear behind the glass."
msgid "quest.task.order_window.result.rest"
msgstr "The scent rests in the window frame. For once, no lamp burns until dawn."
msgid "quest.task.order_window.result.plain"
msgstr "The plant survives on a sunless windowsill. For now."

msgid "quest.task.care_hungry.name"
msgstr "Hungry"
msgid "quest.task.care_hungry.body"
msgstr "Before shopping, decide what might fill you tonight."
msgid "quest.task.care_hungry.slot"
msgstr "Something for yourself to eat"
msgid "quest.task.care_hungry.result.hash_brown"
msgstr "The crunch is clearer than the hourly radio signal."
msgid "quest.task.care_hungry.result.warm_milk"
msgstr "Milk cools around the rim. You decide this counts as supper."
msgid "quest.task.care_hungry.result.plain"
msgstr "Before the mall goes dark, you keep a little something for yourself."
msgid "quest.task.care_sleepless.name"
msgstr "Not Ready to Sleep"
msgid "quest.task.care_sleepless.body"
msgstr "The night has only just become yours. It need not end yet."
msgid "quest.task.care_sleepless.slot"
msgstr "Something to stay awake with"
msgid "quest.task.care_sleepless.result.plain"
msgstr "There is another sound in the room. Sleep cannot find the door."
msgid "quest.task.care_bedside.name"
msgstr "Something by the Bed"
msgid "quest.task.care_bedside.body"
msgstr "A small place by the bed waits for something you bring home tonight."
msgid "quest.task.care_bedside.slot"
msgstr "A plant for the night"
msgid "quest.task.care_bedside.result.sunflower"
msgstr "The flower faces the ceiling lamp, mistaking it for the sun."
msgid "quest.task.care_bedside.result.jasmine"
msgstr "Only after lights-out does the fragrance find its outline."
msgid "quest.task.care_bedside.result.lavender"
msgstr "A small, purple silence begins breathing beside the pillow."
msgid "quest.task.care_bedside.result.plain"
msgstr "The plant spends the night quietly beside the bed."
msgid "quest.task.care_rain.name"
msgstr "The Rain Is Too Close"
msgid "quest.task.care_rain.body"
msgstr "Rain presses against the window. You want something between it and you."
msgid "quest.task.care_rain.slot"
msgstr "Something soft or warm"
msgid "quest.task.care_rain.result.plain"
msgstr "Rain continues, but its sound retreats beyond something soft."

msgid "quest.task.owner_balloon.name"
msgstr "Erase the Smile"
msgid "quest.task.owner_balloon.body"
msgstr "Uncle Balloon wants to erase his printed smile, or stop himself from floating away."
msgid "quest.task.owner_balloon.slot"
msgstr "Only one answer can be given"
msgid "quest.task.owner_balloon.result.flight"
msgstr "The smile fades. He rises past the sign and softly touches the ceiling."
msgid "quest.task.owner_balloon.result.ground"
msgstr "His shoes meet the floor completely. The smile remains, but no longer strains."

msgid "quest.owner.balloon.name"
msgstr "Uncle Balloon"
msgid "quest.owner.balloon.idle"
msgstr "Uncle Balloon folds his gloves on the counter. His printed smile does not move."
msgid "quest.owner.balloon.item_comment"
msgstr "%s. He taps the price tag. It has waited here longer than I have."
msgid "quest.owner.balloon.request"
msgstr "Banana solvent might erase a smile. Heavier air might keep me here."
msgid "quest.owner.balloon.reminder"
msgstr "Uncle Balloon holds down his smile, waiting for you to bring back one answer."
msgid "quest.owner.balloon.departed"
msgstr "A string hangs behind the counter. There is no balloon at its end."
msgid "quest.owner.balloon.grounded"
msgstr "Uncle Balloon sits on a folding chair, both shoes resting firmly on the floor."

msgid "quest.owner.sunflower.name"
msgstr "Mr. Sunflower"
msgid "quest.owner.sunflower.idle"
msgstr "Mr. Sunflower says nothing. His petals turn slightly toward the damp light."
msgid "quest.owner.sunflower.item_comment"
msgstr "He moves %s nearer the lamp. His petals make a faint papery sound."

msgid "quest.owner.mouse.name"
msgstr "Ratty"
msgid "quest.owner.mouse.idle"
msgstr "The mouse costume waves. Only the vending machines hum in the kitchen."
msgid "quest.owner.mouse.item_comment"
msgstr "%s! Eat it at night and the flavor gets a little more serious."

msgid "quest.owner.gramophone.name"
msgstr "Miss Gramophone"
msgid "quest.owner.gramophone.idle"
msgstr "Miss Gramophone polishes the needle and pretends not to notice you."
msgid "quest.owner.gramophone.item_comment"
msgstr "%s. Records remember. Prices do not."

msgid "quest.owner.magical_girl.name"
msgstr "Chika"
msgid "quest.owner.magical_girl.idle"
msgstr "Chika peers over a stack of books as if she has waited all night."
msgid "quest.owner.magical_girl.item_comment"
msgstr "%s. Do not trust the cover; the night inside is longer."

msgid "quest.store_unlock.record.slot"
msgstr "Moth-shaped recess"
msgid "quest.store_unlock.record.prompt"
msgstr "A moth-shaped piece is missing from the shutter."
msgid "quest.store_unlock.record.result"
msgstr "The clockwork moth circles the seam. The shutter rises."
msgid "quest.store_unlock.book.slot"
msgstr "Center of the paper sun"
msgid "quest.store_unlock.book.prompt"
msgstr "The papier-mâché sun is missing its center."
msgid "quest.store_unlock.book.result"
msgstr "The sunflower completes it. A daylight-colored lamp wakes inside."

msgid "quest.ui.hand.title"
msgstr "Things in hand"
msgid "quest.ui.back"
msgstr "Back"
msgid "quest.ui.money"
msgstr "◇ %d"
msgid "quest.ui.day_money"
msgstr "Night %d  ·  ◇ %d"
msgid "quest.ui.next_day"
msgstr "Next night"
msgid "quest.ui.next_day.confirm_title"
msgstr "Leave the mall?"
msgid "quest.ui.next_day.confirm_body"
msgstr "Leave now. Confirmed tasks settle during the interlude; everything else waits for another night."
msgid "quest.ui.next_day.confirm"
msgstr "Leave"
msgid "quest.ui.cancel"
msgstr "Stay a while"
msgid "quest.ui.map.locked"
msgstr "Locked"
msgid "quest.ui.shop.shelf"
msgstr "Shelf"
msgid "quest.ui.shop.sold"
msgstr "Empty"
msgid "quest.ui.shop.checkout"
msgstr "Checkout  ◇%d"
msgid "quest.ui.shop.done"
msgstr "The items settle into your paper bag."
msgid "quest.ui.shop.no_money"
msgstr "Not enough money."
msgid "quest.ui.shop.empty"
msgstr "Nothing is selected yet."
msgid "quest.ui.shop.page_locked"
msgstr "This page has not been opened yet."
msgid "quest.ui.owner.talk"
msgstr "Talk"
msgid "quest.ui.owner.none"
msgstr "Unattended"
msgid "quest.ui.recycle.hint"
msgstr "Drag unwanted cards here. The counter returns their actual purchase price."
msgid "quest.ui.recycle.checkout"
msgstr "Return  %d / ◇%d"
msgid "quest.ui.recycle.done"
msgstr "The items vanish behind the counter. The coins return to your hand."
msgid "quest.ui.arc.night"
msgstr "Night %d · Deliveries"
msgid "quest.ui.arc.task_source"
msgstr "REQUEST"
msgid "quest.ui.arc.empty"
msgstr "There are no parcels to deliver tonight. The mall lights go out behind you, one by one."
msgid "quest.ui.arc.new_day"
msgstr "Night %d"
msgid "quest.ui.task.slot.ready"
msgstr "Suitable"
msgid "quest.ui.task.slot.weak"
msgstr "Not enough"
msgid "quest.ui.task.confirm"
msgstr "Confirm"
msgid "quest.ui.task.deliver_tomorrow"
msgstr "Deliver tomorrow"
msgid "quest.ui.task.gift"
msgstr "Receive"
msgid "quest.ui.task.enjoy_tonight"
msgstr "Enjoy at home tonight"
msgid "quest.ui.task.cancel_confirm"
msgstr "Unconfirm"
msgid "quest.ui.task.confirmed"
msgstr "Packed. It will settle when you leave the mall."
msgid "quest.ui.task.not_ready"
msgstr "It fits, but its strength is not enough."
msgid "quest.ui.synthesis.open"
msgstr "Enter the Colors Within"
msgid "quest.ui.synthesis.title"
msgstr "Colors Within the Bag"
msgid "quest.ui.synthesis.unknown"
msgstr "An unnamed shape"
msgid "quest.ui.synthesis.hint"
msgstr "Place a few things together. They may remember another shape."
msgid "quest.ui.synthesis.working"
msgstr "Something rustles softly in the bottom of the bag…"
msgid "quest.ui.synthesis.action"
msgstr "Combine"
msgid "quest.ui.synthesis.material"
msgstr "Material"
msgid "quest.ui.synthesis.material.description"
msgstr "First, set down one definite thing. It tells the bag what it may remember. [Place one item as the material; its item types determine the candidate recipes, and it provides all of its Personas.]"
msgid "quest.ui.synthesis.borrow_self"
msgstr "borrow myself"
msgid "quest.ui.synthesis.borrow_self.description"
msgstr "Sometimes, I can borrow a little strength from myself. [Drag in one Persona card; its current level is added to the synthesis, and the card is not consumed.]"
msgid "quest.ui.synthesis.borrow_item"
msgstr "borrow an item"
msgid "quest.ui.synthesis.borrow_item.description"
msgstr "Another thing can lend me the night it remembers. [Drag in one item; it provides all of its Personas but does not affect candidate recipes, and is consumed after a successful synthesis.]"
msgid "quest.ui.synthesis.possibility.title"
msgstr "Possibility"
msgid "quest.ui.synthesis.possibility.default"
msgstr "It is not imagining what is there, but forgetting what is absent."
msgid "quest.ui.synthesis.known_hint"
msgstr "Someone has hinted at this shape."
msgid "quest.ui.synthesis.unknown_hint"
msgstr "This recipe does not have a name yet."
msgid "demo.property.food.name"
msgstr "Food"
msgid "demo.property.food.description"
msgstr "Something that can be eaten."
msgid "demo.property.salty.name"
msgstr "Salty"
msgid "demo.property.salty.description"
msgstr "The distinct taste left by salt."
msgid "demo.property.plant.name"
msgstr "Plant"
msgid "demo.property.plant.description"
msgstr "Something still growing, or still remembering sunlight."
msgid "demo.property.drink.name"
msgstr "Drink"
msgid "demo.property.drink.description"
msgstr "Liquid kept in a bottle, cup, or can."
msgid "demo.property.metal.name"
msgstr "Metal"
msgid "demo.property.metal.description"
msgstr "Cold, hard, and shaped by machines."
msgid "demo.property.tool.name"
msgstr "Tool"
msgid "demo.property.tool.description"
msgstr "Something made to change other things."
msgid "demo.stat.fantasy.name"
msgstr "Fantasy"
msgid "demo.stat.fantasy.description"
msgstr "Makes nonexistent things briefly visible."
msgid "demo.stat.memory.name"
msgstr "Memory"
msgid "demo.stat.memory.description"
msgstr "Draws you back through old objects."
msgid "demo.stat.electric.name"
msgstr "Electricity"
msgid "demo.stat.electric.description"
msgstr "The influence of motors, current, and fluorescent light."
msgid "demo.stat.soft.name"
msgstr "Softness"
msgid "demo.stat.soft.description"
msgstr "The feeling of sinking in, being wrapped, or being held."

msgid "demo.item.fries.name"
msgstr "Fries"
msgid "demo.item.fries.description"
msgstr "Crisp-fried, with grains of salt at the bottom of the packet."
msgid "demo.item.jasmine.name"
msgstr "Jasmine"
msgid "demo.item.jasmine.description"
msgstr "Jasmine at night, tucking sleep into a small cluster of white blossoms."
msgid "demo.item.agave.name"
msgstr "Agave"
msgid "demo.item.agave.description"
msgstr "Its thick leaves hold the night's moisture."
msgid "demo.item.cola.name"
msgstr "Cola"
msgid "demo.item.cola.description"
msgstr "They say it tastes best from a glass bottle."
msgid "demo.item.scissors.name"
msgstr "Scissors"
msgid "demo.item.scissors.description"
msgstr "Cold metal scissors that make a clean snip as they close."

msgid "demo.store.flower.name"
msgstr "Flower Shop"
msgid "demo.store.record.name"
msgstr "Nocturne"
msgid "demo.owner.flower.name"
msgstr "Mr. Sunflower"
msgid "demo.owner.flower.idle"
msgstr "Welcome..."
msgid "demo.owner.flower.item_comment"
msgstr "Want to see... %s..."
msgid "demo.owner.flower.request"
msgstr "..."
msgid "demo.owner.flower.reminder"
msgstr "Look at my stem again... Those tiny white flowers are still there."
msgid "demo.owner.flower.state.trimmed"
msgstr "I feel lighter... Those tiny white flowers are gone."
msgid "demo.owner.flower.state.blooming"
msgstr "Let them keep blooming... They have had plenty to drink."
msgid "demo.owner.record.name"
msgstr "Miss Gramophone"
msgid "demo.owner.record.idle"
msgstr "I've never seen you before... What do you want?"
msgid "demo.owner.record.item_comment"
msgstr "Keep that %s away from me."

msgid "demo.unlock.record.slot"
msgstr "Someone carrying flowers"
msgid "demo.unlock.record.prompt"
msgstr "A gramophone silhouette shows through red velvet curtains. They say the owner has no patience for people—except those carrying flowers."
msgid "demo.unlock.record.result"
msgstr "Nocturne is now open."

msgid "demo.property.flower.name"
msgstr "Flower"

msgid "demo.property.flower.description"
msgstr "Something that blooms, withers, and leaves a scent behind."

msgid "demo.property.toy.name"
msgstr "Toy"

msgid "demo.property.toy.description"
msgstr "Something made for play or companionship."

msgid "demo.property.rose.name"
msgstr "Rose"

msgid "demo.property.rose.description"
msgstr "A flower that has never grown inside Concrete City."

msgid "demo.property.teddy_bear.name"
msgstr "Teddy Bear"

msgid "demo.property.teddy_bear.description"
msgstr "The particular outline left by a bear-shaped toy."

msgid "demo.item.toy_block.name"
msgstr "Old Building Block"

msgid "demo.item.toy_block.description"
msgstr "A faded wooden block that still counts as a toy."

msgid "demo.item.midnight_rose.name"
msgstr "Midnight Rose"

msgid "demo.item.midnight_rose.description"
msgstr "A rose that does not exist in Concrete City. Its petals resemble a piece of remembered midnight."

msgid "demo.item.worn_teddy.name"
msgstr "Worn Teddy Bear"

msgid "demo.item.worn_teddy.description"
msgstr "Its worn patches make it seem as if someone held it for years."

msgid "demo.item.baby_teddy.name"
msgstr "Baby Comfort Bear"

msgid "demo.item.baby_teddy.description"
msgstr "Soft enough to catch a cry and remain through a very long sleep."

msgid "demo.item.pale_teddy.name"
msgstr "Pale Teddy Bear"

msgid "demo.item.pale_teddy.description"
msgstr "Its color stayed on the far side of the mirror, leaving a quiet pale toy."

msgid "demo.item.soft_gauze.name"
msgstr "Soft Gauze"

msgid "demo.item.soft_gauze.description"
msgstr "A scrap of cloth so light it seems cut from a dream."

msgid "demo.item.mirror_shard.name"
msgstr "Old Mirror Shard"

msgid "demo.item.mirror_shard.description"
msgstr "An old mirror shard with worn-smooth edges and a faint reflection."

msgid "demo.recipe.base.flower"
msgstr "Any flower"

msgid "demo.recipe.base.toy"
msgstr "Any toy"

msgid "demo.recipe.base.worn_teddy"
msgstr "Worn Teddy Bear"

msgid "demo.recipe.midnight_rose.name"
msgstr "Midnight Rose"

msgid "demo.recipe.worn_teddy.name"
msgstr "Worn Teddy Bear"

msgid "demo.recipe.baby_teddy.name"
msgstr "Baby Comfort Bear"

msgid "demo.recipe.pale_teddy.name"
msgstr "Pale Teddy Bear"

msgid "demo.recipe.midnight_rose.process.1"
msgstr "You remember a flower that has never bloomed in Concrete City."

msgid "demo.recipe.midnight_rose.process.2"
msgstr "Gauze wraps that nonexistent memory around a set of petals."

msgid "demo.recipe.midnight_rose.process.3"
msgstr "The color of midnight slowly acquires a scent."

msgid "demo.recipe.worn_teddy.process.1"
msgstr "The toy's hard corners soften in your palm."

msgid "demo.recipe.worn_teddy.process.2"
msgstr "Pillow fills it with time that has already been held."

msgid "demo.recipe.worn_teddy.process.3"
msgstr "Wear appears on it before memory does."

msgid "demo.recipe.baby_teddy.process.1"
msgstr "Old stuffing becomes full again."

msgid "demo.recipe.baby_teddy.process.2"
msgstr "Pillow teaches every seam how to comfort."

msgid "demo.recipe.baby_teddy.process.3"
msgstr "It waits quietly for the next cry."

msgid "demo.recipe.pale_teddy.process.1"
msgstr "The mirror draws the color out of the toy."

msgid "demo.recipe.pale_teddy.process.2"
msgstr "Its old outline becomes clearer inside the pallor."

msgid "demo.recipe.pale_teddy.process.3"
msgstr "It opens its eyes from inside the reflection."

msgid "demo.recipe.scissors.process.1"
msgstr "Metal reveals a sharp outline beneath the lamp."

msgid "demo.recipe.scissors.process.2"
msgstr "Two thin blades bite together in your imagination."

msgid "quest.ui.hand.items"
msgstr "Items"

msgid "quest.ui.hand.personas"
msgstr "Personas"

msgid "demo.property.persona.name"
msgstr "Persona"

msgid "demo.property.persona.description"
msgstr "A Persona that names how you feel and answer the night."

msgid "demo.persona.lamplighter.name"
msgstr "The Lamplighter"

msgid "demo.persona.lamplighter.description"
msgstr "A detective, an investigator, a scholar working at midnight. Night makes my mind clearer."

msgid "demo.persona.nightwatcher.name"
msgstr "The Nightwatcher"

msgid "demo.persona.nightwatcher.description"
msgstr "A nostalgic ghost, a late night call-in radio host, Proust. Night makes me remember sorrowful things."

msgid "demo.persona.dreamwalker.name"
msgstr "The Dreamwalker"

msgid "demo.persona.dreamwalker.description"
msgstr "A nightingale, a surrealist writer, Van Gogh beneath the stars. Night leaves my inspiration nowhere to hide."

msgid "demo.persona.homecomer.name"
msgstr "The Homecomer"

msgid "demo.persona.homecomer.description"
msgstr "Someone leaving work, someone enjoying a late-night meal, someone sleeping soundly. May I sleep well tonight, tonight."

msgid "demo.shape.light.name"
msgstr "Light"

msgid "demo.shape.light.description"
msgstr "Alternating current, a brightly lit street corner, moths crackling. [Shape of the night: reason, curiosity]"

msgid "demo.shape.tear.name"
msgstr "Tear"

msgid "demo.shape.tear.description"
msgstr "See me, and you see another self. Hold me, and you hold your own other hand. [Shape of the night: empathy, compassion]"

msgid "demo.shape.dream.name"
msgstr "Dream"

msgid "demo.shape.dream.description"
msgstr "Ancient fish swim across the bedroom wall; wet concrete branches bloom with white flowers. [Shape of the night: hallucination, inspiration]"

msgid "demo.shape.sleep.name"
msgstr "Sleep"

msgid "demo.shape.sleep.description"
msgstr "A cool goose-down quilt, lavender at the bedside, a moment of solace before dawn. [Shape of the night: pleasure, rest]"

msgid "demo.ui.synthesis.candidates"
msgstr "Possible Shapes"

msgid "demo.ui.synthesis.no_candidates"
msgstr "No shape appears inside the bag"

msgid "demo.ui.synthesis.totals"
msgstr "Properties in the Bag"

msgid "demo.ui.synthesis.personas"
msgstr "Choose One Persona"

msgid "demo.ui.synthesis.unknown_candidate"
msgstr "???"

msgid "demo.ui.synthesis.flip_result"
msgstr "Click to reveal"

msgid "demo.ui.synthesis.drag_result"
msgstr "Drag into hand"

msgid "demo.task.girl.name"
msgstr "The Little Girl's Request"
msgid "demo.task.girl.body"
msgstr "Dear shopper: All they have brought me lately is cabbage, and I have had enough. Please bring me something to eat—anything! (Something salty would be best.)"
msgid "demo.task.girl.slot"
msgstr "Something edible"
msgid "demo.task.girl.result.salty"
msgstr "The girl in the fish tank raved about your fries and asked you to bring ketchup next time."
msgid "demo.task.girl.result.plain"
msgstr "The girl in the fish tank accepted the food you brought."
msgid "demo.task.self_care.name"
msgstr "Take Care of Yourself"
msgid "demo.task.self_care.body"
msgstr "Bring yourself something to drink tonight."
msgid "demo.task.self_care.slot"
msgstr "A drink"
msgid "demo.task.self_care.result"
msgstr "Fresh lemon, the scent of alcohol—you fall asleep to the crackle of bubbles."
msgid "demo.task.mouse.name"
msgstr "The Mouse's Request"
msgid "demo.task.mouse.body"
msgstr "The note contains only the outline of a leaf."
msgid "demo.task.mouse.slot"
msgstr "A plant"
msgid "demo.task.mouse.result"
msgstr "The mouse took the plant and quickly vanished into the mall's shadows."
msgid "demo.task.flower_owner.name"
msgstr "Mr. Sunflower's Request"
msgid "demo.task.flower_owner.body"
msgstr "Mr. Sunflower says nothing. He only points at his neck—or rather, his green stem. Tiny white flowers are growing there. Does he want them cut away, or left to flourish?"
msgid "demo.task.flower_owner.slot.trim"
msgstr "To stop the white flowers growing, I can give him a cold tool."
msgid "demo.task.flower_owner.slot.nourish"
msgstr "To help the white flowers flourish, I can give him a nourishing drink."
msgid "demo.task.flower_owner.result.trimmed"
msgstr "The scissors close, and the tiny white flowers fall into an apron pocket."
msgid "demo.task.flower_owner.result.blooming"
msgstr "The white flowers drink deeply and keep growing in the nighttime shop."

msgid "demo.task.tin_boy.name"
msgstr "The Tin Boy's Request"

msgid "demo.task.tin_boy.body"
msgstr "Dear Shopping Bag:\nThank you for helping me buy a toy!\nI'm still scared, so I sent you instead.\nThe place is called Joy Joy Toys. The owner's beard is very prickly.\nThis is the tin frog I bought before. If he doesn't know you, show it to him."

msgid "demo.item.tin_frog.name"
msgstr "Tin Frog"

msgid "demo.item.tin_frog.description"
msgstr "A spring inside its tin belly refuses to sleep. Wind it, and it hops twice toward the nearest light."
msgid "opening.property.cd.name"
msgstr "CD"

msgid "opening.property.cd.description"
msgstr "A disc that plays sound, and an item category."

msgid "opening.property.book.name"
msgstr "Book"

msgid "opening.property.book.description"
msgstr "Bound words, pictures, and a few thoughts that refuse to disperse."

msgid "opening.property.cassette.name"
msgstr "Cassette"

msgid "opening.property.cassette.description"
msgstr "An item category that winds sound between two spools."

msgid "opening.property.candle.name"
msgstr "Candle"

msgid "opening.property.candle.description"
msgstr "It makes a small circle of light by making itself shorter."

msgid "opening.property.clothing.name"
msgstr "Clothing"

msgid "opening.property.clothing.description"
msgstr "Worn outside the body to provide warmth, or make a statement in its place."

msgid "opening.item.kaleidoscope.name"
msgstr "Kaleidoscope"

msgid "opening.item.kaleidoscope.description"
msgstr "It twists the mall's broken light into a street that cannot exist. Turn it again and the exit moves."

msgid "opening.item.lotus_candle.name"
msgstr "Lotus Candle"

msgid "opening.item.lotus_candle.description"
msgstr "Wind the base and it sings Happy Birthday in a small metal voice. No one knows who is growing older."

msgid "opening.item.mung_bean_cake.name"
msgstr "Mung Bean Cake"

msgid "opening.item.mung_bean_cake.description"
msgstr "A food that makes people sad. At the end of the festival, the living-room table is piled with it."

msgid "opening.item.milkshake.name"
msgstr "Milkshake"

msgid "opening.item.milkshake.description"
msgstr "Ratty's smiling face is printed on the cup. The cream is already a little cloying; the straw still points toward happiness."

msgid "opening.item.cola.name"
msgstr "Cola"

msgid "opening.item.cola.description"
msgstr "The indisputable classic. In the drifting markets at the end of the century, it became valuable hard currency."

msgid "opening.item.fries.name"
msgstr "Fries"

msgid "opening.item.fries.description"
msgstr "Crisp and delicious for exactly five minutes after frying. In minute six, they only remember their golden age."

msgid "opening.item.nuggets.name"
msgstr "Chicken Nuggets"

msgid "opening.item.nuggets.description"
msgstr "No logo. Yellow with a touch of pink. Strange. They are definitely not chicken—at least, not any chicken you know."

msgid "opening.item.gardenia.name"
msgstr "Gardenia"

msgid "opening.item.gardenia.description"
msgstr "Its fragrance is almost painfully white, admitting its sweetness only after midnight. An invitation without a signature."

msgid "opening.item.cactus.name"
msgstr "Cactus Ball"

msgid "opening.item.cactus.description"
msgstr "Round, silent, and fully armed. Under fluorescent light, it continues to believe in the desert."

msgid "opening.item.jasmine.name"
msgstr "Jasmine"

msgid "opening.item.jasmine.description"
msgstr "A few white flowers soften the night with fragrance. They bloom quietly, as if afraid of waking someone."

msgid "opening.item.ratty_doll.name"
msgstr "Ratty Doll"

msgid "opening.item.ratty_doll.description"
msgstr "Sewn in Ratty's image, with the left ear coming loose. The old stuffing remembers a child's fierce embrace."

msgid "opening.item.fruit_wine.name"
msgstr "Fruit Wine"

msgid "opening.item.fruit_wine.description"
msgstr "Its color resembles dusk squeezed from cheap candy wrappers. The first sip is sweet; the second begins dreaming for you."

msgid "opening.item.camellia.name"
msgstr "Camellia"

msgid "opening.item.camellia.description"
msgstr "The petals are layered in an order so strict it becomes sorrowful. When it falls, it returns itself to the ground whole."

msgid "opening.item.foam_fake_flower.name"
msgstr "Foam Flower"

msgid "opening.item.foam_fake_flower.description"
msgstr "Foam petals that never wilt and never bloomed. The label calls it gardening; the texture insists it is a toy."

msgid "opening.item.candy_fake_flower.name"
msgstr "Candy Flower"

msgid "opening.item.candy_fake_flower.description"
msgstr "Candy wrappers, wire, and an irresponsible spring. It looks edible—which is rarely good news."

msgid "opening.item.goldberg_variations.name"
msgstr "Goldberg Variations"

msgid "opening.item.goldberg_variations.description"
msgstr "A cassette of expensive manufacture. On the cover, a faceless male musician poses with absolute faith that applause is coming."

msgid "opening.item.debussy_clair_de_lune.name"
msgstr "Debussy's Clair de Lune"

msgid "opening.item.debussy_clair_de_lune.description"
msgstr "The piano ladles moonlight into the room. When the piece ends, the water remains on the ceiling."

msgid "opening.item.conservatory_story.name"
msgstr "The Story of the Conservatory"

msgid "opening.item.conservatory_story.description"
msgstr "“You have no choice but to compose.” Everyone in the book says so, as if a choice once existed."

msgid "opening.item.nocturne_competition_recording.name"
msgstr "Nocturne (Competition Recording)"

msgid "opening.item.nocturne_competition_recording.description"
msgstr "A bootleg of a music competition. The pops sound like tiny gunfire, but the piano is agile and unruly. The performer was probably drunk."

msgid "opening.item.concrete_city_vol_1.name"
msgstr "Welcome to Concrete City (Vol. I)"

msgid "opening.item.concrete_city_vol_1.description"
msgstr "A bizarre fin-de-siècle bestseller, readable from any page. Some say it predicted the end; others simply refuse to finish Volume II."

msgid "opening.item.mirror_and_lamp.name"
msgstr "The Mirror and the Lamp"

msgid "opening.item.mirror_and_lamp.description"
msgstr "Should literature mirror life, or become a lamp that illuminates it? The argument is forty dollars thick."

msgid "opening.item.ufo_exploration_magazine.name"
msgstr "UFO Exploration Magazine"

msgid "opening.item.ufo_exploration_magazine.description"
msgstr "The ink is not quite dry, yet seventeen suspicious reflections have been circled in the sky. Each page is more certain we are not alone."

msgid "opening.item.mania_manga.name"
msgstr "mania manga"

msgid "opening.item.mania_manga.description"
msgstr "Their eyes are large enough to hold two incompatible sorrows. The final page is printed twice. Perhaps it was not a mistake."

msgid "opening.item.cold_teddy_bear.name"
msgstr "Cold Teddy Bear"

msgid "opening.item.cold_teddy_bear.description"
msgstr "Its fur keeps the temperature of the back of a freezer. Hold it close and a forgotten winter holds you back."

msgid "opening.item.baby_soothing_bear.name"
msgstr "Baby Soothing Bear"

msgid "opening.item.baby_soothing_bear.description"
msgstr "A slow clockwork heart hides in its chest. It can hum only one lullaby, and that lullaby has no words."

msgid "opening.item.birthday_cake.name"
msgstr "Birthday Cake"

msgid "opening.item.birthday_cake.description"
msgstr "Its candles remember a birthday no one attended. The icing is sweet like a sin asking to be forgiven."

msgid "opening.item.rose.name"
msgstr "Rose"

msgid "opening.item.rose.description"
msgstr "It has no morning dew and needs no morning. Every petal is practicing how to become a secret."

msgid "opening.recipe.base.toy"
msgstr "Any toy"

msgid "opening.recipe.base.food"
msgstr "Any food"

msgid "opening.recipe.base.drink"
msgstr "Any drink"

msgid "opening.recipe.base.flower"
msgstr "Any flower"

msgid "opening.recipe.cold_teddy_bear.name"
msgstr "Cold Teddy Bear"

msgid "opening.recipe.cold_teddy_bear.process.1"
msgstr "The toy's stuffing turns cold. It begins remembering winters that never belonged to it."

msgid "opening.recipe.cold_teddy_bear.process.2"
msgstr "The seam closes. The new bear has no body heat, but it is very good at being missed."

msgid "opening.recipe.baby_soothing_bear.name"
msgstr "Baby Soothing Bear"

msgid "opening.recipe.baby_soothing_bear.process.1"
msgstr "Softness wraps the noise layer by layer, leaving only a slow and regular heartbeat."

msgid "opening.recipe.baby_soothing_bear.process.2"
msgstr "It learns a wordless lullaby and decides never to sing the ending."

msgid "opening.recipe.birthday_cake.name"
msgstr "Birthday Cake"

msgid "opening.recipe.birthday_cake.process.1"
msgstr "Food is shaped into a celebration. Icing conceals the date and everyone who failed to attend."

msgid "opening.recipe.birthday_cake.process.2"
msgstr "The candles light themselves. They insist this day once belonged to someone."

msgid "opening.recipe.cola.name"
msgstr "Cola"

msgid "opening.recipe.cola.process.1"
msgstr "Weariness gathers into brown syrup. It remembers a formula no longer manufactured."

msgid "opening.recipe.cola.process.2"
msgstr "Bubbles wake at the bottom of the can. For a few minutes, the world tastes classic again."

msgid "opening.recipe.rose.name"
msgstr "Rose"

msgid "opening.recipe.rose.process.1"
msgstr "Petals unfold from impossible angles, like a secret practicing its own pronunciation."

msgid "opening.recipe.rose.process.2"
msgstr "Thorns emerge along the stem. The dream has learned to protect what it creates."
msgid "opening.store.toy.name"
msgstr "Joy Joy Toys"

msgid "opening.store.fast_food.name"
msgstr "Ratty’s Kitchen"

msgid "opening.store.flower.name"
msgstr "Flower Shop"

msgid "opening.store.record.name"
msgstr "Nocturne"

msgid "opening.store.bookstore.name"
msgstr "Sun & Moon Books"

msgid "opening.unlock.toy.prompt"
msgstr "The shutter of Joy Joy Toys is raised only a crack. Behind the glass, Uncle Balloon points to the tin frog in my hand, then taps gently on the lock."

msgid "opening.unlock.toy.slot"
msgstr "Tin Frog"

msgid "opening.unlock.toy.result"
msgstr "The tin frog touches the lock. Something hollow answers from its belly. Uncle Balloon lifts the shutter for me."

msgid "opening.unlock.fast_food.prompt"
msgstr "At the service window, someone in a rat costume bows and says they are closed for the day. But perhaps I only want somewhere to sit. I can bring my own food."

msgid "opening.unlock.fast_food.slot"
msgstr "Any food"

msgid "opening.unlock.fast_food.result"
msgstr "Ratty puts away the CLOSED sign and wipes clean a table beside the window."

msgid "opening.unlock.flower.prompt"
msgstr "A crooked note is taped to the flower shop window: PROVE WHO YOU ARE. The enormous shadow beyond the glass lowers its head and waits for my reflection to speak first."

msgid "opening.unlock.flower.slot"
msgstr "Proof of who I am"

msgid "opening.unlock.flower.result"
msgstr "My Persona appears in the glass. Mr. Sunflower studies it for a long time, then pushes the door open from within."

msgid "opening.unlock.record.prompt"
msgstr "A gramophone's shadow shows through the velvet curtains. Uncle Balloon tells me the owner has no patience for people—except those carrying roses. But roses cannot possibly exist in New Millennium Mall."

msgid "opening.unlock.record.slot"
msgstr "A rose"

msgid "opening.unlock.record.result"
msgstr "The rose is left beside the door. Behind the curtain, a needle settles onto a record."

msgid "opening.unlock.bookstore.prompt"
msgstr "The sign of Sun & Moon Books is still lit, but its door is hidden behind an endless row of spines. Chika slips a note through a gap: BRING SOMETHING THAT LETS INSPIRATION KEEP GROWING."

msgid "opening.unlock.bookstore.slot"
msgstr "Something that feeds inspiration"

msgid "opening.unlock.bookstore.result"
msgstr "The object dreams briefly. The book spines retreat one by one, and a door appears between two shelves."

msgid "opening.owner.toy.name"
msgstr "Uncle Balloon"

msgid "opening.owner.toy.idle"
msgstr "Welcome. Tonight's toys are all on the shelf, and their springs and wheels are behaving—for now."

msgid "opening.owner.toy.item"
msgstr "%s. Neither its spring nor its wheels promise to behave."

msgid "opening.owner.fast_food.name"
msgstr "Ratty"

msgid "opening.owner.fast_food.idle"
msgstr "The fryer is hot. Tell me what you want before it gets cold."

msgid "opening.owner.fast_food.item"
msgstr "%s. Take it while it still remembers being warm."

msgid "opening.owner.flower.name"
msgstr "Mr. Sunflower"

msgid "opening.owner.flower.idle"
msgstr "Shh... The flowers are asleep. Choose gently."

msgid "opening.owner.flower.item"
msgstr "%s. At night, do not ask whether it is real."

msgid "opening.property.keepsake.name"
msgstr "Keepsake"

msgid "opening.property.keepsake.description"
msgstr "An object recognized by a particular bond. [A Keepsake can only be placed in a request slot.]"

msgid "opening.item.concrete_city_vol_2.name"
msgstr "Welcome to Concrete City (Vol. II)"

msgid "opening.item.concrete_city_vol_2.description"
msgstr "Volume I predicted the end. In Volume II, everyone reports to work as usual. The final page insists: begin anywhere."

msgid "opening.item.nocturne_published.name"
msgstr "Nocturne - Published Cassette"

msgid "opening.item.nocturne_published.description"
msgstr "The pops have been cleaned away, along with half the drunkenness. The performer's name is printed smaller than the night."

msgid "opening.item.shopping_card.name"
msgstr "Shopping Card"

msgid "opening.item.shopping_card.description"
msgstr "A shopping card with no store name. Four nights that cancel one another are stored in its magnetic stripe."

msgid "opening.owner.record.name"
msgstr "Miss Gramophone"

msgid "opening.owner.record.idle"
msgstr "Bach for anxiety, Mozart for fatigue. Chopin, though... every feeling the night contains is there. Which do you need?"

msgid "opening.owner.record.item"
msgstr "%s. At least it knows how it ought to be heard."

msgid "opening.owner.bookstore.name"
msgstr "Chika"

msgid "opening.owner.bookstore.idle"
msgstr "Are you looking for a book, or someone to talk to? Either is fine. I happen to handle both."

msgid "opening.owner.bookstore.item"
msgstr "%s! I've read this one. Or possibly only from somewhere in the middle."

msgid "owner_request.fast_food.name"
msgstr "Ratty's Kitchen: Cola"

msgid "owner_request.fast_food.body"
msgstr "\"I miss the taste of cola, but perhaps there isn't any left in this building. If you find some, I'd be glad to share it.\" Ratty sets two straws on the polished counter."

msgid "owner_request.fast_food.footer"
msgstr "Reward: $60, Homecomer +1"

msgid "owner_request.fast_food.slot"
msgstr "Cola"

msgid "owner_request.fast_food.accept"
msgstr "If you see any cola... could you bring it back? There may be none in this building. But if there is, we'll split it."

msgid "owner_request.fast_food.reminder"
msgstr "Cola. I'm not rushing you! I just... still remember the taste."

msgid "owner_request.fast_food.completed"
msgstr "So that was the old taste... more or less. Thank you for finishing it with me."

msgid "owner_request.fast_food.result"
msgstr "Ratty holds the can in both hands, cradling a small piece of ordinary life that has not quite ended. \"That's it. Half for each of us—though I haven't worked out how this suit is meant to drink.\""

msgid "owner_request.flower.name"
msgstr "Flower Shop: Something Soft"

msgid "owner_request.flower.body"
msgstr "Mr. Sunflower opens a palm broader than a flowerpot. \"Want... something soft...\" Cold or soothing, either teddy bear will do."

msgid "owner_request.flower.footer"
msgstr "Reward: two new flowers and one gardenia"

msgid "owner_request.flower.slot"
msgstr "Any Teddy Bear"

msgid "owner_request.flower.accept"
msgstr "He lowers his enormous body and points to the empty space in his arms. Want... something soft..."

msgid "owner_request.flower.reminder"
msgstr "Soft... bear. He shapes something very small between his arms."

msgid "owner_request.flower.completed"
msgstr "The teddy bear sits on his shoulder. Every new flower leans toward it."

msgid "owner_request.flower.result"
msgstr "He settles the bear on his shoulder. The new flowers bend toward it. After a long silence, he cuts a gardenia from his shoulder and offers it to you. Soil begins to stir in the empty shelf spaces."

msgid "owner_request.toy.name"
msgstr "Joy Joy Toys: Birthday Cake"

msgid "owner_request.toy.body"
msgstr "\"If you find a birthday cake, could you bring it back? I want to know whether those children ever got to blow out their candles.\" Uncle Balloon is still smiling, but his string has gone taut."

msgid "owner_request.toy.footer"
msgstr "Reward: $20, The Nightwatcher +1"

msgid "owner_request.toy.slot"
msgstr "Birthday Cake"

msgid "owner_request.toy.accept"
msgstr "If you find a birthday cake, could you bring it back? I want to know whether those children ever got to blow out their candles."

msgid "owner_request.toy.reminder"
msgstr "The cake doesn't have to be pretty. It only needs candles."

msgid "owner_request.toy.completed"
msgstr "At least this birthday wasn't forgotten."

msgid "owner_request.toy.result"
msgstr "Uncle Balloon holds the cake while the string above him pulls taut. \"Thank you. At least this birthday wasn't forgotten.\" You hold his lowered hand until he stops drifting upward."

msgid "owner_request.record.name"
msgstr "Nocturne: Published Cassette"

msgid "owner_request.record.body"
msgstr "\"You may have heard her playing. What did you think?\" Miss Gramophone wants the polished published recording of Nocturne."

msgid "owner_request.record.footer"
msgstr "Reward: $60, The Lamplighter +1"

msgid "owner_request.record.slot"
msgstr "Nocturne - Published Cassette"

msgid "owner_request.record.accept"
msgstr "You may have heard her playing. What did you think? If you find the published Nocturne, bring it to me. I need to verify... a few details."

msgid "owner_request.record.reminder"
msgstr "The published cassette. Precise, spotless, without a single accident. That person was always like that."

msgid "owner_request.record.completed"
msgstr "Bach for anxiety, Mozart for fatigue. Chopin, though... every feeling of the night is there."

msgid "owner_request.record.result"
msgstr "She reaches the end without lifting the needle. \"Not one wrong note. She is always like that.\" The needle continues across the blank tail. She slides your payment over without saying whether she liked it."

msgid "owner_request.bookstore.name"
msgstr "Sun & Moon Books: Volume II"

msgid "owner_request.bookstore.body"
msgstr "Chika opens Volume I somewhere in the middle, then flips back. \"Have you seen Volume II? I drew a manga for this book once. My friends said it was scary—only a little.\""

msgid "owner_request.bookstore.footer"
msgstr "Reward: $60, Dreamwalker +1"

msgid "owner_request.bookstore.slot"
msgstr "Welcome to Concrete City (Vol. II)"

msgid "owner_request.bookstore.accept"
msgstr "Have you seen Volume II? I drew a manga for this book once. My friends said it was scary—only a little."

msgid "owner_request.bookstore.reminder"
msgstr "Welcome to Concrete City, Volume II. Starting at the final page won't hurt. It may actually be better."

msgid "owner_request.bookstore.completed"
msgstr "My manga can be started on any page too! My friends just don't like starting it."

msgid "owner_request.bookstore.result"
msgstr "Chika presses Volume II flat beneath her hands. The magical girl on her mask is still smiling. \"See? Starting here makes perfect sense. My manga is the same. Probably.\" She has reached the last page and still hasn't stopped talking."

msgid "quest.ui.arc.item_reward"
msgstr "Received: %s"

msgid "quest.ui.arc.flip_reward"
msgstr "Flip"

msgid "quest.ui.arc.continue_reward"
msgstr "Click to continue"

msgid "archive.room_001.title"
msgstr "Room 001 Next Millennium Mall"

msgid "archive.room_001.body"
msgstr "Few investigators have reported its existence, and fewer still have returned safely.\nRead alongside a certain poem, the evidence suggests that in 1999 our world possessed another possibility.\nThis mall, exiled beyond time, is proof that possibility once existed."
