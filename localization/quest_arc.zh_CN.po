msgstr "交流电、马达与荧光灯留下的影响。"
msgid "demo.stat.soft.name"
msgstr "柔软"
msgid "demo.stat.soft.description"
msgstr "可以陷进去、包起来或抱住的感觉。"

msgid "demo.item.fries.name"
msgstr "薯条"
msgid "demo.item.fries.description"
msgstr "炸得酥脆，盐粒落在纸袋底部。"
msgid "demo.item.jasmine.name"
msgstr "茉莉"
msgid "demo.item.jasmine.description"
msgstr "夜里的茉莉，将睡意藏进一小簇白花。"
msgid "demo.item.agave.name"
msgstr "龙舌兰"
msgid "demo.item.agave.description"
msgstr "厚实的叶片里存着夜晚的水分。"
msgid "demo.item.cola.name"
msgstr "可乐"
msgid "demo.item.cola.description"
msgstr "据说玻璃瓶装的口感才最好。"
msgid "demo.item.scissors.name"
msgstr "剪刀"
msgid "demo.item.scissors.description"
msgstr "冰冷的金属剪刀，开合时发出清脆的咔嚓声。"

msgid "demo.store.flower.name"
msgstr "花店"
msgid "demo.store.record.name"
msgstr "夜曲"
msgid "demo.owner.flower.name"
msgstr "向日葵先生"
msgid "demo.owner.flower.idle"
msgstr "欢迎……"
msgid "demo.owner.flower.item_comment"
msgstr "想看……%s……"
msgid "demo.owner.flower.request"
msgstr "……"
msgid "demo.owner.flower.reminder"
msgstr "再看看我的茎……那些小白花还在。"
msgid "demo.owner.flower.state.trimmed"
msgstr "轻多了……那些小白花已经不见了。"
msgid "demo.owner.flower.state.blooming"
msgstr "就让它们继续开吧……水已经喝饱了。"
msgid "demo.owner.record.name"
msgstr "留声机女士"
msgid "demo.owner.record.idle"
msgstr "我没见过你……有什么事吗？"
msgid "demo.owner.record.item_comment"
msgstr "把%s拿远一点。"

msgid "demo.unlock.record.slot"
msgstr "带花束的人"
msgid "demo.unlock.record.prompt"
msgstr "红色天鹅绒窗帘透出留声机的影子。听说店主对人毫无耐心，但拿着花束的人除外。"
msgid "demo.unlock.record.result"
msgstr "夜曲已解锁。"

msgid "demo.property.flower.name"
msgstr "花"

msgid "demo.property.flower.description"
msgstr "一类会开放、凋谢，并留下气味的东西。"

msgid "demo.property.toy.name"
msgstr "玩具"

msgid "demo.property.toy.description"
msgstr "为了游戏或陪伴而制成的东西。"

msgid "demo.property.rose.name"
msgstr "玫瑰"

msgid "demo.property.rose.description"
msgstr "砼城里没有生长过的花。"

msgid "demo.property.teddy_bear.name"
msgstr "泰迪熊"

msgid "demo.property.teddy_bear.description"
msgstr "一只熊形玩偶留下的特殊轮廓。"

msgid "demo.item.toy_block.name"
msgstr "旧积木"

msgid "demo.item.toy_block.description"
msgstr "颜色已经褪去的木积木，仍然算得上一件玩具。"

msgid "demo.item.midnight_rose.name"
msgstr "午夜玫瑰"

msgid "demo.item.midnight_rose.description"
msgstr "砼城中不存在的玫瑰。花瓣像午夜里被想起的一小片天空。"

msgid "demo.item.worn_teddy.name"
msgstr "破旧泰迪熊"

msgid "demo.item.worn_teddy.description"
msgstr "磨损的位置好像曾经被谁抱过很多年。"

msgid "demo.item.baby_teddy.name"
msgstr "婴儿安抚熊"

msgid "demo.item.baby_teddy.description"
msgstr "柔软得足以接住哭声，也足以陪伴一场很长的睡眠。"

msgid "demo.item.pale_teddy.name"
msgstr "苍白泰迪熊"

msgid "demo.item.pale_teddy.description"
msgstr "镜中的颜色被留在了另一边，只剩下一只安静的苍白玩偶。"

msgid "demo.item.soft_gauze.name"
msgstr "柔软纱布"

msgid "demo.item.soft_gauze.description"
msgstr "一小块轻得像从睡梦里剪下来的柔软布料。"

msgid "demo.item.mirror_shard.name"
msgstr "旧镜片"

msgid "demo.item.mirror_shard.description"
msgstr "边缘已经磨钝的旧镜片，仍留着微弱的反光。"

msgid "demo.recipe.base.flower"
msgstr "任意花"

msgid "demo.recipe.base.toy"
msgstr "任意玩具"

msgid "demo.recipe.base.worn_teddy"
msgstr "破旧泰迪熊"

msgid "demo.recipe.midnight_rose.name"
msgstr "午夜玫瑰"

msgid "demo.recipe.worn_teddy.name"
msgstr "破旧泰迪熊"

msgid "demo.recipe.baby_teddy.name"
msgstr "婴儿安抚熊"

msgid "demo.recipe.pale_teddy.name"
msgstr "苍白泰迪熊"

msgid "demo.recipe.midnight_rose.process.1"
msgstr "你记得一种从未在砼城开放过的花。"

msgid "demo.recipe.midnight_rose.process.2"
msgstr "纱把那段不存在的记忆裹在花瓣外。"

msgid "demo.recipe.midnight_rose.process.3"
msgstr "午夜的颜色慢慢有了香气。"

msgid "demo.recipe.worn_teddy.process.1"
msgstr "玩具的棱角在掌心里变得柔软。"

msgid "demo.recipe.worn_teddy.process.2"
msgstr "枕替它填入一段被拥抱过的时间。"

msgid "demo.recipe.worn_teddy.process.3"
msgstr "磨损先于记忆出现在它身上。"

msgid "demo.recipe.baby_teddy.process.1"
msgstr "旧棉絮重新蓬松起来。"

msgid "demo.recipe.baby_teddy.process.2"
msgstr "枕让每一处接缝都学会安慰。"

msgid "demo.recipe.baby_teddy.process.3"
msgstr "它安静地等待下一次哭声。"

msgid "demo.recipe.pale_teddy.process.1"
msgstr "镜面从玩偶身上取走颜色。"

msgid "demo.recipe.pale_teddy.process.2"
msgstr "旧日的轮廓在苍白中变得清楚。"

msgid "demo.recipe.pale_teddy.process.3"
msgstr "它从倒影里睁开眼睛。"

msgid "demo.recipe.scissors.process.1"
msgstr "金属在灯下显出锋利的轮廓。"

msgid "demo.recipe.scissors.process.2"
msgstr "两片薄刃在想象中咬合。"

msgid "quest.ui.hand.items"
msgstr "物品"

msgid "quest.ui.hand.masks"
msgstr "面相"

msgid "demo.property.persona.name"
msgstr "面相"

msgid "demo.property.persona.description"
msgstr "标记你如何感受并回应夜晚的面相。"

msgid "demo.mask.nightwalker.name"
msgstr "夜行者"

msgid "demo.mask.nightwalker.description"
msgstr "交流电，明亮的街角，飞蛾噼啪作响。夜晚使我的头脑更加清醒。[夜之面相，理性、好奇]"

msgid "demo.mask.mourner.name"
msgstr "悼念者"

msgid "demo.mask.mourner.description"
msgstr "看见我，你就看到了另一个自己。握住我，你就握住了自己的另一只手。夜晚使我想起忧伤之事。[夜之面相，共情、怀旧]"

msgid "demo.mask.dreamwalker.name"
msgstr "梦游者"

msgid "demo.mask.dreamwalker.description"
msgstr "远古鱼游过卧室的墙，湿漉漉的水泥枝条开满白花，夜晚使我的灵感无所遁形。[夜之面相，幻觉、随想]"

msgid "demo.mask.homecomer.name"
msgstr "倦归者"

msgid "demo.mask.homecomer.description"
msgstr "凉爽的鹅绒被，床头的薰衣草，天明前的片刻慰藉。祝我今夜好眠，今夜。[夜之面相，享受、安歇]"

msgid "demo.ui.synthesis.candidates"
msgstr "可能的形状"

msgid "demo.ui.synthesis.no_candidates"
msgstr "袋中没有浮现任何形状"

msgid "demo.ui.synthesis.totals"
msgstr "袋中属性"

msgid "demo.ui.synthesis.personas"
msgstr "选择一种人格"

msgid "demo.ui.synthesis.unknown_candidate"
msgstr "？？？"

msgid "demo.ui.synthesis.flip_result"
msgstr "点击翻开"

msgid "demo.ui.synthesis.drag_result"
msgstr "拖入手牌"

msgid "demo.task.girl.name"
msgstr "小女孩的委托"
msgid "demo.task.girl.body"
msgstr "亲爱的购物员：这几天他们送来的都是卷心菜，我真的受够了。请帮我带点吃的，什么都行！（最好是咸味的）"
msgid "demo.task.girl.slot"
msgstr "可以吃的东西"
msgid "demo.task.girl.result.salty"
msgstr "鱼缸女孩对你带来的薯条赞不绝口，并希望你下次能带一包番茄酱。"
msgid "demo.task.girl.result.plain"
msgstr "鱼缸女孩收下了你带来的食物。"
msgid "demo.task.self_care.name"
msgstr "照顾自己"
msgid "demo.task.self_care.body"
msgstr "今晚，给自己带一杯饮品。"
msgid "demo.task.self_care.slot"
msgstr "一杯饮品"
msgid "demo.task.self_care.result"
msgstr "鲜柠檬，酒精的气味，你伴随着气泡的噼啪声入睡。"
msgid "demo.task.mouse.name"
msgstr "老鼠的委托"
msgid "demo.task.mouse.body"
msgstr "纸条上只有一片叶子的轮廓。"
msgid "demo.task.mouse.slot"
msgstr "一株植物"
msgid "demo.task.mouse.result"
msgstr "老鼠收下植物，很快消失在商场的阴影里。"
msgid "demo.task.flower_owner.name"
msgstr "向日葵先生的委托"
msgid "demo.task.flower_owner.body"
msgstr "向日葵先生没有说话，只是指了指自己的脖颈——或者说，绿色的茎。我看到那里长出了细小的白花。他想摘掉它们，还是任其生长？"
msgid "demo.task.flower_owner.slot.trim"
msgstr "让白花不再生长，我可以给他冰冷的工具。"
msgid "demo.task.flower_owner.slot.nourish"
msgstr "让白花更加繁盛，我可以给他滋润的饮品。"
msgid "demo.task.flower_owner.result.trimmed"
msgstr "剪刀合拢，细小的白花落进围裙口袋。"
msgid "demo.task.flower_owner.result.blooming"
msgstr "白花喝饱了水，在夜里的花店继续生长。"

msgid "demo.task.tin_boy.name"
msgstr "铁皮男孩的委托"

msgid "demo.task.tin_boy.body"
msgstr "亲爱的购物袋：\n谢谢你帮我买玩具！\n我还是hai怕所以就让你来了。\n那家店叫欣欣玩具店，老板的胡子很zha。\n这是我之前买的铁皮青蛙，要是他跟你不熟，就给他看。"

msgid "demo.item.tin_frog.name"
msgstr "铁皮青蛙"

msgid "demo.item.tin_frog.description"
msgstr "铁皮肚子里有一枚不肯睡的发条。上紧它，它会朝最近的灯光跳两步。"
msgid "opening.property.cd.name"
msgstr "光盘"

msgid "opening.property.cd.description"
msgstr "能够播放声音的圆盘，也是一种物品类别。"

msgid "opening.property.book.name"
msgstr "书"

msgid "opening.property.book.description"
msgstr "装订起来的文字、图像，以及一些不肯散去的念头。"

msgid "opening.property.cassette.name"
msgstr "磁带"

msgid "opening.property.cassette.description"
msgstr "把声音缠在两只线轴之间的物品类别。"

msgid "opening.property.candle.name"
msgstr "蜡烛"

msgid "opening.property.candle.description"
msgstr "以自身缩短为代价，制造一小圈光。"

msgid "opening.property.clothing.name"
msgstr "衣服"

msgid "opening.property.clothing.description"
msgstr "穿在身体外面，替人保暖或替人说话。"

msgid "opening.item.kaleidoscope.name"
msgstr "万花筒"

msgid "opening.item.kaleidoscope.description"
msgstr "把商场的碎光拧成一条不会存在的街。再转一下，出口也会换位置。"

msgid "opening.item.lotus_candle.name"
msgstr "莲花蜡烛"

msgid "opening.item.lotus_candle.description"
msgstr "拧紧底座，它便用细小的金属嗓子唱起生日歌。没有人知道它在祝谁长大。"

msgid "opening.item.mung_bean_cake.name"
msgstr "绿豆糕"

msgid "opening.item.mung_bean_cake.description"
msgstr "一种使人悲伤的食物，在节日的尾声，客厅的茶几上堆满了这个。"

msgid "opening.item.milkshake.name"
msgstr "奶昔"

msgid "opening.item.milkshake.description"
msgstr "杯上印着大老鼠的笑脸，奶油已经有点腻了。吸管仍执着地指向快乐。"

msgid "opening.item.cola.name"
msgstr "可乐"

msgid "opening.item.cola.description"
msgstr "绝对经典的口味。在世纪末的漂流市场中，它成为了高价值的硬通货。"

msgid "opening.item.fries.name"
msgstr "薯条"

msgid "opening.item.fries.description"
msgstr "酥脆可口，仅限出锅前五分钟。第六分钟开始，它们只是在回忆自己的黄金时代。"

msgid "opening.item.nuggets.name"
msgstr "鸡块"

msgid "opening.item.nuggets.description"
msgstr "没有标志，颜色黄中带粉，有点奇怪。吃起来绝对不是鸡肉——至少不是你认识的鸡。"

msgid "opening.item.gardenia.name"
msgstr "栀子"

msgid "opening.item.gardenia.description"
msgstr "香气白得近乎刺眼，到了后半夜才肯承认自己的甜。它像一封没有署名的邀请。"

msgid "opening.item.cactus.name"
msgstr "仙人球"

msgid "opening.item.cactus.description"
msgstr "圆，沉默，武装齐全。它在荧光灯下继续相信沙漠。"

msgid "opening.item.jasmine.name"
msgstr "茉莉"

msgid "opening.item.jasmine.description"
msgstr "几朵白花把夜色熏得柔软。它们开得很轻，像怕吵醒谁。"

msgid "opening.item.ratty_doll.name"
msgstr "老鼠娃娃"

msgid "opening.item.ratty_doll.description"
msgstr "照着大老鼠的样子缝成，左耳已经脱线。旧棉絮还保留着某个孩子用力拥抱的形状。"

msgid "opening.item.fruit_wine.name"
msgstr "果味酒"

msgid "opening.item.fruit_wine.description"
msgstr "颜色像从廉价糖纸里榨出的黄昏。第一口很甜，第二口开始替你做梦。"

msgid "opening.item.camellia.name"
msgstr "山茶"

msgid "opening.item.camellia.description"
msgstr "花瓣层层叠叠，秩序严密得近乎悲伤。凋落时，它会把整个自己交还给地面。"

msgid "opening.item.foam_fake_flower.name"
msgstr "泡沫假花"

msgid "opening.item.foam_fake_flower.description"
msgstr "泡沫切出的花瓣永远不会谢，也永远没有开过。标签说这是园艺，手感坚持说这是玩具。"

msgid "opening.item.candy_fake_flower.name"
msgstr "糖果假花"

msgid "opening.item.candy_fake_flower.description"
msgstr "糖纸、铁丝和一场不负责任的春天。它看起来可以吃——这通常不是好消息。"

msgid "opening.item.goldberg_variations.name"
msgstr "哥德堡变奏曲"

msgid "opening.item.goldberg_variations.description"
msgstr "一卷制作考究的磁带。封面上的男音乐家面目模糊，仍保持着一个确信掌声将至的姿势。"

msgid "opening.item.debussy_clair_de_lune.name"
msgstr "德彪西月光"

msgid "opening.item.debussy_clair_de_lune.description"
msgstr "钢琴把月光一勺一勺舀进房间。曲子结束后，水面仍留在天花板上。"

msgid "opening.item.conservatory_story.name"
msgstr "《音乐学院的故事》"

msgid "opening.item.conservatory_story.description"
msgstr "“你别无选择，只有作曲。”书中每个人都这样说，仿佛选择曾经存在过。"

msgid "opening.item.nocturne_competition_recording.name"
msgstr "夜曲（比赛录音）"

msgid "opening.item.nocturne_competition_recording.description"
msgstr "一场音乐大赛的盗录。爆豆声像微小的枪火，钢琴却灵动得不守规矩；演奏者大概醉了。"

msgid "opening.item.concrete_city_vol_1.name"
msgstr "欢迎来到砼城（上半册）"

msgid "opening.item.concrete_city_vol_1.description"
msgstr "世纪末的离奇畅销书，据说从任何一页开始都可以。有人声称它预测了末日——也有人只是不肯读完下半册。"

msgid "opening.item.mirror_and_lamp.name"
msgstr "镜与灯"

msgid "opening.item.mirror_and_lamp.description"
msgstr "文学应该像镜子，照见生活；还是像灯，替生活发光？这本书争论了四十元那么厚。"

msgid "opening.item.ufo_exploration_magazine.name"
msgstr "飞碟探索杂志"

msgid "opening.item.ufo_exploration_magazine.description"
msgstr "印刷油墨尚未完全干透，天空已经被圈出十七处可疑反光。每一页都比上一页更确信我们并不孤独。"

msgid "opening.item.mania_manga.name"
msgstr "mania manga"

msgid "opening.item.mania_manga.description"
msgstr "人物的眼睛大得足以盛下两种不相容的悲伤。最后一页被印了两次，也许不是失误。"

msgid "opening.item.cold_teddy_bear.name"
msgstr "冰冷泰迪熊"

msgid "opening.item.cold_teddy_bear.description"
msgstr "它的绒毛保存着冰箱深处的温度。抱紧它时，某个已经忘记的冬天也会抱紧你。"

msgid "opening.item.baby_soothing_bear.name"
msgstr "婴儿安抚熊"

msgid "opening.item.baby_soothing_bear.description"
msgstr "胸腔里藏着一枚迟钝的发条心。它只会哼一支没有歌词的摇篮曲。"

msgid "opening.item.birthday_cake.name"
msgstr "生日蛋糕"

msgid "opening.item.birthday_cake.description"
msgstr "蜡烛记得一个没人出席的生日。奶油很甜，甜得像一项需要被原谅的罪。"

msgid "opening.item.rose.name"
msgstr "玫瑰"

msgid "opening.item.rose.description"
msgstr "它没有晨露，也不需要清晨。每一片花瓣都在练习如何成为一个秘密。"

msgid "opening.recipe.base.toy"
msgstr "任意玩具"

msgid "opening.recipe.base.food"
msgstr "任意食物"

msgid "opening.recipe.base.drink"
msgstr "任意饮料"

msgid "opening.recipe.base.flower"
msgstr "任意花"

msgid "opening.recipe.cold_teddy_bear.name"
msgstr "冰冷泰迪熊"

msgid "opening.recipe.cold_teddy_bear.process.1"
msgstr "玩具的填充物变得冰冷。它开始记得一些并不属于它的冬天。"

msgid "opening.recipe.cold_teddy_bear.process.2"
msgstr "缝线闭合。新的熊没有体温，却很擅长被怀念。"

msgid "opening.recipe.baby_soothing_bear.name"
msgstr "婴儿安抚熊"

msgid "opening.recipe.baby_soothing_bear.process.1"
msgstr "柔软把噪音一层层包起来，只留下规律而迟钝的心跳。"

msgid "opening.recipe.baby_soothing_bear.process.2"
msgstr "它学会一支没有歌词的摇篮曲，并决定永远不唱到结尾。"

msgid "opening.recipe.birthday_cake.name"
msgstr "生日蛋糕"

msgid "opening.recipe.birthday_cake.process.1"
msgstr "食物被塑成庆典的样子。奶油掩住了日期，也掩住了缺席者。"

msgid "opening.recipe.birthday_cake.process.2"
msgstr "蜡烛自行点亮。它坚持今天曾经属于某个人。"

msgid "opening.recipe.cola.name"
msgstr "可乐"

msgid "opening.recipe.cola.process.1"
msgstr "倦意聚成褐色糖浆。它记得一种已经停产的配方。"

msgid "opening.recipe.cola.process.2"
msgstr "气泡从罐底醒来。世界因此恢复了几分钟的经典口味。"

msgid "opening.recipe.rose.name"
msgstr "玫瑰"

msgid "opening.recipe.rose.process.1"
msgstr "花瓣从不可能的角度依次展开，像一个秘密在练习自己的发音。"

msgid "opening.recipe.rose.process.2"
msgstr "茎上长出尖刺。梦终于学会保护它所创造的东西。"
msgid "opening.store.toy.name"
msgstr "欣欣玩具店"

msgid "opening.store.fast_food.name"
msgstr "老鼠厨房"

msgid "opening.store.flower.name"
msgstr "花店"

msgid "opening.store.record.name"
msgstr "夜曲"

msgid "opening.store.bookstore.name"
msgstr "日月光书店"

msgid "opening.unlock.toy.prompt"
msgstr "卷帘门后传来发条空转的声音。拿出任何玩具，证明你知道该怎样和这里相处。"

msgid "opening.unlock.toy.slot"
msgstr "任何玩具"

msgid "opening.unlock.toy.result"
msgstr "门锁认出了玩具，卷帘门缓慢升起。"

msgid "opening.unlock.fast_food.prompt"
msgstr "店门口挂着牌子：请自带食物。带来任何食物，门才会打开。"

msgid "opening.unlock.fast_food.slot"
msgstr "任何食物"

msgid "opening.unlock.fast_food.result"
msgstr "牌子晃了一下，店里的灯亮了。"

msgid "opening.unlock.flower.prompt"
msgstr "玻璃门后全是沉睡的白花。展示任何一张 Persona，让它们认出今夜的你。"

msgid "opening.unlock.flower.slot"
msgstr "任何 Persona"

msgid "opening.unlock.flower.result"
msgstr "面具映在玻璃上，花店从倒影里打开。"

msgid "opening.unlock.record.prompt"
msgstr "唱针停在寂静的唱片上。这里明确要求一朵玫瑰。"

msgid "opening.unlock.record.slot"
msgstr "玫瑰"

msgid "opening.unlock.record.result"
msgstr "玫瑰被留在门边，唱片开始转动。"

msgid "opening.unlock.bookstore.prompt"
msgstr "书页在门缝里自行翻动。夜行者或梦游者 Persona 达到 3 级，才看得清门牌。"

msgid "opening.unlock.bookstore.slot"
msgstr "3级夜行者或梦游者"

msgid "opening.unlock.bookstore.result"
msgstr "书脊依次发出轻响，门出现在两排书之间。"

msgid "opening.owner.toy.name"
msgstr "气球叔叔"

msgid "opening.owner.toy.idle"
msgstr "欢迎光临。今晚的玩具都在货架上，发条和轮子暂时还算听话。"

msgid "opening.owner.toy.item"
msgstr "%s。发条和轮子都不保证听话。"

msgid "opening.owner.fast_food.name"
msgstr "大老鼠"

msgid "opening.owner.fast_food.idle"
msgstr "炸锅正热着。想吃什么就说，别让它们等凉了。"

msgid "opening.owner.fast_food.item"
msgstr "%s。最好趁它还记得温度时带走。"

msgid "opening.owner.flower.name"
msgstr "向日葵先生"

msgid "opening.owner.flower.idle"
msgstr "嘘……花已经睡了。挑选的时候轻一点。"

msgid "opening.owner.flower.item"
msgstr "%s。夜里别问它究竟是真是假。"
