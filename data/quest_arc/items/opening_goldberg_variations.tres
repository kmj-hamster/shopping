[gd_resource type="Resource" script_class="QuestItemDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/quest_item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_property_set.gd" id="2_props"]
[ext_resource type="Texture2D" path="res://resources/items/goldberg_variations.png" id="3_image"]

[sub_resource type="Resource" id="Props"]
script = ExtResource("2_props")
tags = Array[StringName]([&"cassette"])
values = {&"sleep": 2, &"light": 2}

[resource]
script = ExtResource("1_item")
id = &"goldberg_variations"
display_name_key = &"opening.item.goldberg_variations.name"
description_key = &"opening.item.goldberg_variations.description"
image = ExtResource("3_image")
store_id = &"record"
base_price = 20
property_set = SubResource("Props")
