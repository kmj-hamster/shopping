[gd_resource type="Resource" script_class="QuestItemDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/quest_item_definition.gd" id="1_item"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_property_set.gd" id="2_props"]
[ext_resource type="Texture2D" path="res://resources/ui/property-mirror.svg" id="3_image"]

[sub_resource type="Resource" id="Props"]
script = ExtResource("2_props")
