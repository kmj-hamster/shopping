[gd_resource type="Resource" script_class="SynthesisRecipeDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/slot_domain/synthesis_recipe_definition.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]

[sub_resource type="Resource" id="BaseRule"]
script = ExtResource("2_rule")
id = &"test_cassette_base"
display_name_key = &"test.recipe.base.cassette"
required_all = Array[StringName]([&"cassette"])

[resource]
script = ExtResource("1_recipe")
id = &"recipe_test_unsent_message"
display_name_key = &"test.recipe.unsent_message.name"
base_rule = SubResource("BaseRule")
required_personas = {&"mourner": 6}
output_id = &"test_unsent_message"
process_text_keys = Array[StringName]([&"test.recipe.unsent_message.process.1", &"test.recipe.unsent_message.process.2"])
