[gd_resource type="Resource" script_class="SynthesisRecipeDefinition" load_steps=9 format=3]

[ext_resource type="Script" path="res://scripts/slot_domain/synthesis_recipe_definition.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/slot_domain/slot_value_requirement.gd" id="3_value"]

[sub_resource type="Resource" id="SweetValue"]
script = ExtResource("3_value")
tags = Array[StringName]([&"sweet"])
minimum = 3

[sub_resource type="Resource" id="SweetRule"]
script = ExtResource("2_rule")
id = &"sweet_liquid"
display_name_key = &"quest.recipe.banana_water.slot.sweet_liquid"
required_all = Array[StringName]([&"drink", &"sweet"])
allowed_any = Array[StringName]([&"lamp", &"candle"])
forbidden_any = Array[StringName]([&"food"])
value_requirements = Array[Resource]([SubResource("SweetValue")])

[sub_resource type="Resource" id="SolventRule"]
script = ExtResource("2_rule")
id = &"solvent"
display_name_key = &"quest.recipe.banana_water.slot.solvent"
required_all = Array[StringName]([&"solvent"])
allowed_any = Array[StringName]([&"mirror", &"candle"])
forbidden_any = Array[StringName]([&"food"])

[resource]
script = ExtResource("1_recipe")
id = &"recipe_banana_water"
display_name_key = &"quest.recipe.banana_water.name"
unlock_story_flag = &"balloon_request_active"
duration_seconds = 2.5
slot_rules = Array[Resource]([SubResource("SweetRule"), SubResource("SolventRule")])
compared_aspects = Array[StringName]([&"lamp", &"candle"])
tie_winner = &"candle"
output_by_aspect = {&"lamp": &"craft_banana_water", &"candle": &"craft_banana_water"}
preview_text_by_output = {&"craft_banana_water": &"quest.recipe.banana_water.preview"}
