[gd_resource type="Resource" script_class="SynthesisRecipeDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/slot_domain/synthesis_recipe_definition.gd" id="1_recipe"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]

[sub_resource type="Resource" id="MetalRule"]
script = ExtResource("2_rule")
id = &"metal"
display_name_key = &"demo.recipe.scissors.slot.metal"
required_all = Array[StringName]([&"metal"])
accepted_item_ids = Array[StringName]([&"cola"])

[sub_resource type="Resource" id="LampRule"]
script = ExtResource("2_rule")
id = &"lamp"
display_name_key = &"demo.recipe.scissors.slot.lamp"
required_all = Array[StringName]([&"lamp"])
accepted_item_ids = Array[StringName]([&"sunflower"])

[resource]
script = ExtResource("1_recipe")
id = &"recipe_scissors"
display_name_key = &"demo.recipe.scissors.name"
known_at_start = true
duration_seconds = 0.1
slot_rules = Array[Resource]([SubResource("MetalRule"), SubResource("LampRule")])
compared_aspects = Array[StringName]([&"lamp", &"mirror"])
tie_winner = &"lamp"
output_by_aspect = {&"lamp": &"scissors", &"mirror": &"scissors"}
preview_text_by_output = {&"scissors": &"demo.recipe.scissors.preview"}
