[gd_resource type="Resource" script_class="StoreUnlockDefinition" load_steps=3 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/store_unlock_definition.gd" id="1_unlock"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2_rule")
id = &"bookstore_lock"
display_name_key = &"opening.unlock.bookstore.slot"
detail_title_key = &"opening.unlock.bookstore.slot"
required_label_key = &"expedition.ui.slot.accepts"
allowed_label_key = &"expedition.ui.slot.accepts"
forbidden_label_key = &"expedition.ui.slot.rejects"
required_all = Array[StringName]([&"dream"])
forbidden_any = Array[StringName]([&"persona"])

[resource]
script = ExtResource("1_unlock")
id = &"unlock_bookstore"
store_id = &"bookstore"
prompt_text_key = &"opening.unlock.bookstore.prompt"
result_text_key = &"opening.unlock.bookstore.result"
slot_rule = SubResource("Rule")
