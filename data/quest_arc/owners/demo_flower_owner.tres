[gd_resource type="Resource" script_class="OwnerDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/owner_definition.gd" id="1_owner"]
[ext_resource type="AudioStream" path="res://resources/audio/dialogue/robot_blip_a.wav" id="2_voice_a"]
[ext_resource type="AudioStream" path="res://resources/audio/dialogue/robot_blip_b.wav" id="3_voice_b"]

[resource]
script = ExtResource("1_owner")
id = &"flower_owner"
store_id = &"flower"
display_name_key = &"demo.owner.flower.name"
idle_dialogue_key = &"demo.owner.flower.idle"
item_comment_key = &"demo.owner.flower.item_comment"
request_available_flag = &"flower_request_available"
