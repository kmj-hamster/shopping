event_item_page = 2
state_dialogue_keys = {&"blooming": &"demo.owner.flower.state.blooming", &"trimmed": &"demo.owner.flower.state.trimmed"}
dialogue_voice_streams = Array[AudioStream]([ExtResource("2_voice_a"), ExtResource("3_voice_b")])
