[gd_resource type="Resource" script_class="OwnerDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/owner_definition.gd" id="1_owner"]

[resource]
script = ExtResource("1_owner")
id = &"balloon"
store_id = &"toy"
