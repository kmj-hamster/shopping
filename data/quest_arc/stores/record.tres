[gd_resource type="Resource" script_class="StoreDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/store_definition.gd" id="1_store"]

[resource]
script = ExtResource("1_store")
id = &"record"
display_name_key = &"store.record"
owner_id = &"gramophone"
unlock_definition_id = &"unlock_record_store"
initial_shelf_item_ids = Array[StringName]([&"record_fluorescent_single", &"record_fluorescent_single", &"record_lullaby_cassette", &"record_lullaby_cassette", &"record_rain_blank_tape", &"record_rain_blank_tape"])
