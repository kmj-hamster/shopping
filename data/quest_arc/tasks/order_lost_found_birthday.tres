[gd_resource type="Resource" script_class="TaskDefinition" load_steps=24 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/task_definition.gd" id="1_task"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/quest_domain/task_outcome_definition.gd" id="3_outcome"]
[ext_resource type="Script" path="res://scripts/quest_domain/story_condition.gd" id="4_condition"]
[ext_resource type="Script" path="res://scripts/quest_domain/story_effect.gd" id="5_effect"]

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2_rule")
id = &"remembered_toy"
display_name_key = &"quest.task.order_birthday.slot"
required_all = Array[StringName]([&"toy"])
allowed_any = Array[StringName]([&"mirror", &"pillow"])
forbidden_any = Array[StringName]([&"electric"])

[sub_resource type="Resource" id="RememberedCondition"]
script = ExtResource("4_condition")
kind = 6
key = &"mirror"

[sub_resource type="Resource" id="RememberedMoney"]
script = ExtResource("5_effect")
kind = 0
amount = 7

[sub_resource type="Resource" id="RememberedFlag"]
script = ExtResource("5_effect")
kind = 1
target_id = &"lost_birthday"
text_value = &"remembered"

[sub_resource type="Resource" id="RememberedHint"]
script = ExtResource("5_effect")
kind = 3
target_id = &"recipe_teddy"

[sub_resource type="Resource" id="RememberedEvent"]
script = ExtResource("5_effect")
kind = 1
target_id = &"balloon_event_available"
text_value = &"true"

[sub_resource type="Resource" id="RememberedOutcome"]
script = ExtResource("3_outcome")
id = &"remembered"
result_text_key = &"quest.task.order_birthday.result.remembered"
priority = 10
conditions = Array[Resource]([SubResource("RememberedCondition")])
effects = Array[Resource]([SubResource("RememberedMoney"), SubResource("RememberedFlag"), SubResource("RememberedHint"), SubResource("RememberedEvent")])

[sub_resource type="Resource" id="ComfortCondition"]
script = ExtResource("4_condition")
kind = 6
key = &"pillow"

[sub_resource type="Resource" id="ComfortMoney"]
script = ExtResource("5_effect")
kind = 0
amount = 7

[sub_resource type="Resource" id="ComfortFlag"]
script = ExtResource("5_effect")
kind = 1
target_id = &"lost_birthday"
text_value = &"comfort"

[sub_resource type="Resource" id="ComfortHint"]
script = ExtResource("5_effect")
kind = 3
target_id = &"recipe_teddy"

[sub_resource type="Resource" id="ComfortEvent"]
script = ExtResource("5_effect")
kind = 1
target_id = &"balloon_event_available"
text_value = &"true"

[sub_resource type="Resource" id="ComfortOutcome"]
script = ExtResource("3_outcome")
id = &"comfort"
result_text_key = &"quest.task.order_birthday.result.comfort"
priority = 10
conditions = Array[Resource]([SubResource("ComfortCondition")])
effects = Array[Resource]([SubResource("ComfortMoney"), SubResource("ComfortFlag"), SubResource("ComfortHint"), SubResource("ComfortEvent")])

[sub_resource type="Resource" id="PlainMoney"]
script = ExtResource("5_effect")
kind = 0
amount = 5

[sub_resource type="Resource" id="PlainFlag"]
script = ExtResource("5_effect")
kind = 1
target_id = &"lost_birthday"
text_value = &"plain"

[sub_resource type="Resource" id="PlainHint"]
script = ExtResource("5_effect")
kind = 3
target_id = &"recipe_teddy"

[sub_resource type="Resource" id="PlainEvent"]
script = ExtResource("5_effect")
kind = 1
target_id = &"balloon_event_available"
text_value = &"true"

[sub_resource type="Resource" id="PlainOutcome"]
script = ExtResource("3_outcome")
id = &"plain"
result_text_key = &"quest.task.order_birthday.result.plain"
is_fallback = true
effects = Array[Resource]([SubResource("PlainMoney"), SubResource("PlainFlag"), SubResource("PlainHint"), SubResource("PlainEvent")])

[resource]
script = ExtResource("1_task")
id = &"order_lost_found_birthday"
display_name_key = &"quest.task.order_birthday.name"
body_text_key = &"quest.task.order_birthday.body"
activation_day = 3
slot_rules = Array[Resource]([SubResource("Rule")])
outcomes = Array[Resource]([SubResource("RememberedOutcome"), SubResource("ComfortOutcome"), SubResource("PlainOutcome")])
tie_priority = Array[StringName]([&"pillow", &"mirror"])
