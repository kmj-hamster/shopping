[gd_resource type="Resource" script_class="TaskDefinition" load_steps=12 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/task_definition.gd" id="1_task"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/quest_domain/task_outcome_definition.gd" id="3_outcome"]
[ext_resource type="Script" path="res://scripts/quest_domain/story_condition.gd" id="4_condition"]

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2_rule")
id = &"plant"
display_name_key = &"quest.task.care_bedside.slot"
required_all = Array[StringName]([&"plant"])
allowed_any = Array[StringName]([&"lamp", &"candle", &"pillow"])

[sub_resource type="Resource" id="SunCondition"]
script = ExtResource("4_condition")
kind = 4
item_ids = Array[StringName]([&"flower_sunflower"])

[sub_resource type="Resource" id="SunOutcome"]
script = ExtResource("3_outcome")
id = &"sunflower"
result_text_key = &"quest.task.care_bedside.result.sunflower"
priority = 10
conditions = Array[Resource]([SubResource("SunCondition")])

[sub_resource type="Resource" id="JasmineCondition"]
script = ExtResource("4_condition")
kind = 4
item_ids = Array[StringName]([&"flower_night_jasmine"])

[sub_resource type="Resource" id="JasmineOutcome"]
script = ExtResource("3_outcome")
id = &"jasmine"
result_text_key = &"quest.task.care_bedside.result.jasmine"
priority = 10
conditions = Array[Resource]([SubResource("JasmineCondition")])

[sub_resource type="Resource" id="LavenderCondition"]
script = ExtResource("4_condition")
kind = 4
item_ids = Array[StringName]([&"flower_lavender_sachet"])

[sub_resource type="Resource" id="LavenderOutcome"]
script = ExtResource("3_outcome")
id = &"lavender"
result_text_key = &"quest.task.care_bedside.result.lavender"
priority = 10
conditions = Array[Resource]([SubResource("LavenderCondition")])

[sub_resource type="Resource" id="Fallback"]
script = ExtResource("3_outcome")
id = &"plain"
result_text_key = &"quest.task.care_bedside.result.plain"
is_fallback = true

[resource]
script = ExtResource("1_task")
id = &"care_bedside"
display_name_key = &"quest.task.care_bedside.name"
body_text_key = &"quest.task.care_bedside.body"
category = 1
activation_day = 3
slot_rules = Array[Resource]([SubResource("Rule")])
outcomes = Array[Resource]([SubResource("SunOutcome"), SubResource("JasmineOutcome"), SubResource("LavenderOutcome"), SubResource("Fallback")])
