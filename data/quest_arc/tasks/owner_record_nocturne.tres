[gd_resource type="Resource" script_class="TaskDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/task_definition.gd" id="1_task"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/quest_domain/task_outcome_definition.gd" id="3_outcome"]
[ext_resource type="Script" path="res://scripts/quest_domain/story_effect.gd" id="4_effect"]

[sub_resource type="Resource" id="TapeRule"]
script = ExtResource("2_rule")
id = &"published_nocturne"
display_name_key = &"owner_request.record.slot"
accepted_item_ids = Array[StringName]([&"nocturne_published"])

[sub_resource type="Resource" id="MoneyEffect"]
script = ExtResource("4_effect")
kind = 0
amount = 60

[sub_resource type="Resource" id="PersonaEffect"]
script = ExtResource("4_effect")
kind = 2
target_id = &"light"
amount = 1

[sub_resource type="Resource" id="Outcome"]
script = ExtResource("3_outcome")
id = &"heard_nocturne"
result_text_key = &"owner_request.record.result"
is_fallback = true
effects = Array[Resource]([SubResource("MoneyEffect"), SubResource("PersonaEffect")])

[resource]
script = ExtResource("1_task")
id = &"owner_record_nocturne"
display_name_key = &"owner_request.record.name"
body_text_key = &"owner_request.record.body"
footer_text_key = &"owner_request.record.footer"
category = 2
owner_id = &"record_owner"
store_id = &"record"
slot_rules = Array[Resource]([SubResource("TapeRule")])
outcomes = Array[Resource]([SubResource("Outcome")])
