[gd_resource type="Resource" script_class="TaskDefinition" load_steps=16 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/task_definition.gd" id="1_task"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/quest_domain/task_outcome_definition.gd" id="3_outcome"]
[ext_resource type="Script" path="res://scripts/quest_domain/story_condition.gd" id="4_condition"]
[ext_resource type="Script" path="res://scripts/quest_domain/story_effect.gd" id="5_effect"]

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2_rule")
id = &"midnight_food"
display_name_key = &"quest.task.order_hamster.slot"
required_all = Array[StringName]([&"food"])
forbidden_any = Array[StringName]([&"alcohol"])

[sub_resource type="Resource" id="AwakeCondition"]
script = ExtResource("4_condition")
kind = 6
key = &"lamp"

[sub_resource type="Resource" id="AwakeMoney"]
script = ExtResource("5_effect")
kind = 0
amount = 5

[sub_resource type="Resource" id="AwakeFlag"]
script = ExtResource("5_effect")
kind = 1
target_id = &"hamster_supper"
text_value = &"awake"

[sub_resource type="Resource" id="AwakeOutcome"]
script = ExtResource("3_outcome")
id = &"awake"
result_text_key = &"quest.task.order_hamster.result.awake"
priority = 10
conditions = Array[Resource]([SubResource("AwakeCondition")])
effects = Array[Resource]([SubResource("AwakeMoney"), SubResource("AwakeFlag")])

[sub_resource type="Resource" id="SleepCondition"]
script = ExtResource("4_condition")
kind = 6
key = &"pillow"

[sub_resource type="Resource" id="SleepMoney"]
script = ExtResource("5_effect")
kind = 0
amount = 4

[sub_resource type="Resource" id="SleepFlag"]
script = ExtResource("5_effect")
kind = 1
target_id = &"hamster_supper"
text_value = &"sleep"

[sub_resource type="Resource" id="SleepOutcome"]
script = ExtResource("3_outcome")
id = &"sleep"
result_text_key = &"quest.task.order_hamster.result.sleep"
priority = 10
conditions = Array[Resource]([SubResource("SleepCondition")])
effects = Array[Resource]([SubResource("SleepMoney"), SubResource("SleepFlag")])

[sub_resource type="Resource" id="PlainMoney"]
script = ExtResource("5_effect")
kind = 0
amount = 4

[sub_resource type="Resource" id="PlainFlag"]
script = ExtResource("5_effect")
kind = 1
target_id = &"hamster_supper"
text_value = &"plain"

[sub_resource type="Resource" id="PlainOutcome"]
script = ExtResource("3_outcome")
id = &"plain"
result_text_key = &"quest.task.order_hamster.result.plain"
is_fallback = true
effects = Array[Resource]([SubResource("PlainMoney"), SubResource("PlainFlag")])

[resource]
script = ExtResource("1_task")
id = &"order_hamster_midnight_supper"
display_name_key = &"quest.task.order_hamster.name"
body_text_key = &"quest.task.order_hamster.body"
activation_day = 1
slot_rules = Array[Resource]([SubResource("Rule")])
outcomes = Array[Resource]([SubResource("AwakeOutcome"), SubResource("SleepOutcome"), SubResource("PlainOutcome")])
tie_priority = Array[StringName]([&"lamp", &"pillow"])
