[gd_resource type="Resource" script_class="TaskDefinition" load_steps=10 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/task_definition.gd" id="1_task"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/quest_domain/task_outcome_definition.gd" id="3_outcome"]
[ext_resource type="Script" path="res://scripts/quest_domain/story_condition.gd" id="4_condition"]

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2_rule")
id = &"food"
display_name_key = &"quest.task.care_hungry.slot"
required_all = Array[StringName]([&"food"])
forbidden_any = Array[StringName]([&"alcohol"])

[sub_resource type="Resource" id="HashCondition"]
script = ExtResource("4_condition")
kind = 4
item_ids = Array[StringName]([&"fast_hash_brown"])

[sub_resource type="Resource" id="HashOutcome"]
script = ExtResource("3_outcome")
id = &"hash_brown"
result_text_key = &"quest.task.care_hungry.result.hash_brown"
priority = 10
conditions = Array[Resource]([SubResource("HashCondition")])

[sub_resource type="Resource" id="MilkCondition"]
script = ExtResource("4_condition")
kind = 4
item_ids = Array[StringName]([&"fast_warm_milk"])

[sub_resource type="Resource" id="MilkOutcome"]
script = ExtResource("3_outcome")
id = &"warm_milk"
result_text_key = &"quest.task.care_hungry.result.warm_milk"
priority = 10
conditions = Array[Resource]([SubResource("MilkCondition")])

[sub_resource type="Resource" id="Fallback"]
script = ExtResource("3_outcome")
id = &"plain"
result_text_key = &"quest.task.care_hungry.result.plain"
is_fallback = true

[resource]
script = ExtResource("1_task")
id = &"care_hungry"
display_name_key = &"quest.task.care_hungry.name"
body_text_key = &"quest.task.care_hungry.body"
category = 1
activation_day = 1
slot_rules = Array[Resource]([SubResource("Rule")])
outcomes = Array[Resource]([SubResource("HashOutcome"), SubResource("MilkOutcome"), SubResource("Fallback")])
