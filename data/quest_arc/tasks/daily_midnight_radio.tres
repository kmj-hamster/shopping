[gd_resource type="Resource" script_class="TaskDefinition" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/task_definition.gd" id="1_task"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/slot_domain/slot_value_requirement.gd" id="3_value"]
[ext_resource type="Script" path="res://scripts/quest_domain/task_outcome_definition.gd" id="4_outcome"]
[ext_resource type="Script" path="res://scripts/quest_domain/story_effect.gd" id="5_effect"]

[sub_resource type="Resource" id="Value"]
script = ExtResource("3_value")
tags = Array[StringName]([&"dreamwalker"])
minimum = 2

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2_rule")
id = &"item"
display_name_key = &"task.daily.midnight_radio.slot"
required_all = Array[StringName]([&"cassette"])
value_requirements = Array[Resource]([SubResource("Value")])

[sub_resource type="Resource" id="Money"]
script = ExtResource("5_effect")
kind = 0
amount = 18

[sub_resource type="Resource" id="Outcome"]
script = ExtResource("4_outcome")
id = &"complete"
result_text_key = &"task.daily.midnight_radio.result"
is_fallback = true
effects = Array[Resource]([SubResource("Money")])

[resource]
script = ExtResource("1_task")
id = &"daily_midnight_radio"
display_name_key = &"task.daily.midnight_radio.name"
body_text_key = &"task.daily.midnight_radio.body"
slot_rules = Array[Resource]([SubResource("Rule")])
outcomes = Array[Resource]([SubResource("Outcome")])
selection_pool = 1
counts_toward_daily_limit = true
offer_title_key = &"task.daily.midnight_radio.name"
offer_subtitle_key = &"task.daily.midnight_radio.subtitle"
offer_body_key = &"task.daily.midnight_radio.body"
expiration_text_key = &"task.daily.midnight_radio.expired"
active_night_count = 3
completion_cooldown_nights = 7
expiration_cooldown_nights = 3
