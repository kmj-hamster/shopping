[gd_resource type="Resource" script_class="TaskDefinition" load_steps=20 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/task_definition.gd" id="1_task"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/quest_domain/task_outcome_definition.gd" id="3_outcome"]
[ext_resource type="Script" path="res://scripts/quest_domain/story_condition.gd" id="4_condition"]
[ext_resource type="Script" path="res://scripts/quest_domain/story_effect.gd" id="5_effect"]

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2_rule")
id = &"night_sound"
display_name_key = &"quest.task.order_broadcast.slot"
required_all = Array[StringName]([&"music"])
allowed_any = Array[StringName]([&"lamp", &"mirror", &"candle", &"pillow"])
forbidden_any = Array[StringName]([&"food"])

[sub_resource type="Resource" id="StreetCondition"]
script = ExtResource("4_condition")
kind = 4
item_ids = Array[StringName]([&"record_fluorescent_single"])

[sub_resource type="Resource" id="StreetMoney"]
script = ExtResource("5_effect")
kind = 0
amount = 7

[sub_resource type="Resource" id="StreetFlag"]
script = ExtResource("5_effect")
kind = 1
target_id = &"riverside_broadcast"
text_value = &"street"

[sub_resource type="Resource" id="StreetOutcome"]
script = ExtResource("3_outcome")
id = &"street"
result_text_key = &"quest.task.order_broadcast.result.street"
priority = 10
conditions = Array[Resource]([SubResource("StreetCondition")])
effects = Array[Resource]([SubResource("StreetMoney"), SubResource("StreetFlag")])

[sub_resource type="Resource" id="TideCondition"]
script = ExtResource("4_condition")
kind = 4
item_ids = Array[StringName]([&"record_rain_blank_tape"])

[sub_resource type="Resource" id="TideMoney"]
script = ExtResource("5_effect")
kind = 0
amount = 6

[sub_resource type="Resource" id="TideFlag"]
script = ExtResource("5_effect")
kind = 1
target_id = &"riverside_broadcast"
text_value = &"tide"

[sub_resource type="Resource" id="TideOutcome"]
script = ExtResource("3_outcome")
id = &"tide"
result_text_key = &"quest.task.order_broadcast.result.tide"
priority = 10
conditions = Array[Resource]([SubResource("TideCondition")])
effects = Array[Resource]([SubResource("TideMoney"), SubResource("TideFlag")])

[sub_resource type="Resource" id="MemoryCondition"]
script = ExtResource("4_condition")
kind = 4
item_ids = Array[StringName]([&"record_lullaby_cassette"])

[sub_resource type="Resource" id="MemoryMoney"]
script = ExtResource("5_effect")
kind = 0
amount = 6

[sub_resource type="Resource" id="MemoryFlag"]
script = ExtResource("5_effect")
kind = 1
target_id = &"riverside_broadcast"
text_value = &"memory"

[sub_resource type="Resource" id="MemoryOutcome"]
script = ExtResource("3_outcome")
id = &"memory"
result_text_key = &"quest.task.order_broadcast.result.memory"
priority = 10
conditions = Array[Resource]([SubResource("MemoryCondition")])
effects = Array[Resource]([SubResource("MemoryMoney"), SubResource("MemoryFlag")])

[sub_resource type="Resource" id="PlainMoney"]
script = ExtResource("5_effect")
kind = 0
amount = 5

[sub_resource type="Resource" id="PlainFlag"]
script = ExtResource("5_effect")
kind = 1
target_id = &"riverside_broadcast"
text_value = &"plain"

[sub_resource type="Resource" id="PlainOutcome"]
script = ExtResource("3_outcome")
id = &"plain"
result_text_key = &"quest.task.order_broadcast.result.plain"
is_fallback = true
effects = Array[Resource]([SubResource("PlainMoney"), SubResource("PlainFlag")])

[resource]
script = ExtResource("1_task")
id = &"order_riverside_broadcast"
display_name_key = &"quest.task.order_broadcast.name"
body_text_key = &"quest.task.order_broadcast.body"
activation_day = 2
slot_rules = Array[Resource]([SubResource("Rule")])
outcomes = Array[Resource]([SubResource("StreetOutcome"), SubResource("TideOutcome"), SubResource("MemoryOutcome"), SubResource("PlainOutcome")])
tie_priority = Array[StringName]([&"candle", &"mirror", &"pillow", &"lamp"])
