[resource]
script = ExtResource("1_manifest")
initial_money = 30
maximum_item_price = 20
maximum_properties_per_item = 4
maximum_aspects_per_item = 2
starting_item_ids = Array[StringName]([&"fries"])
properties = Array[Resource]([SubResource("PropertyFood"), SubResource("PropertySalty"), SubResource("PropertyPlant"), SubResource("PropertyDrink"), SubResource("PropertyMetal"), SubResource("PropertyTool"), SubResource("PropertyLamp"), SubResource("PropertyMirror"), SubResource("PropertyFantasy"), SubResource("PropertyMemory"), SubResource("PropertyElectric"), SubResource("PropertySoft")])
items = Array[Resource]([ExtResource("3_item"), ExtResource("4_item"), ExtResource("5_item"), ExtResource("6_item"), ExtResource("7_item")])
tasks = Array[Resource]([ExtResource("8_task"), ExtResource("9_task"), ExtResource("10_task"), ExtResource("11_task")])
