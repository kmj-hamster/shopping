[gd_resource type="Resource" script_class="MallRoomDefinition" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/quest_domain/mall_room_definition.gd" id="1_room"]
[ext_resource type="Script" path="res://scripts/quest_domain/mall_challenge_round_definition.gd" id="2_round"]
[ext_resource type="Script" path="res://scripts/quest_domain/mall_challenge_approach_definition.gd" id="3_approach"]

[sub_resource type="Resource" id="ApproachMusic"]
script = ExtResource("3_approach")
title_text_key = &"expedition.room.gray_hall.music.title"
prompt_text_key = &"expedition.room.gray_hall.music.prompt"
success_text_key = &"expedition.room.gray_hall.music.success"
failure_text_key = &"expedition.room.gray_hall.music.failure"
required_all_type_ids = Array[StringName]([&"cassette"])
required_shape_ids = Array[StringName]([&"light"])
shape_total_required = 4
feedback_primary_shape_id = &"light"

[sub_resource type="Resource" id="ApproachListen"]
script = ExtResource("3_approach")
title_text_key = &"expedition.room.gray_hall.listen.title"
prompt_text_key = &"expedition.room.gray_hall.listen.prompt"
success_text_key = &"expedition.room.gray_hall.listen.success"
failure_text_key = &"expedition.room.gray_hall.listen.failure"
required_persona_shape_id = &"tear"
required_shape_ids = Array[StringName]([&"tear"])
shape_total_required = 5
feedback_primary_shape_id = &"tear"

[sub_resource type="Resource" id="ChallengeRound"]
script = ExtResource("2_round")
challenge_text_keys = Array[StringName]([&"expedition.room.gray_hall.challenge.1", &"expedition.room.gray_hall.challenge.2"])
approaches = Array[Resource]([SubResource("ApproachMusic"), SubResource("ApproachListen")])

[resource]
script = ExtResource("1_room")
id = &"gray_hall"
display_name_key = &"expedition.room.gray_hall.name"
intro_text_keys = Array[StringName]([&"expedition.room.gray_hall.intro.1", &"expedition.room.gray_hall.intro.2"])
challenge_rounds = Array[Resource]([SubResource("ChallengeRound")])
reward_item_id = &"nocturne_published"
slot_count = 2
