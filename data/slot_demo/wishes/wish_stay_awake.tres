[gd_resource type="Resource" script_class="DailyWishDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/slot_domain/daily_wish_definition.gd" id="1_wish"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/slot_domain/slot_value_requirement.gd" id="3_value"]

[sub_resource type="Resource" id="Value"]
script = ExtResource("3_value")
mode = 1
tags = Array[StringName]([&"lamp", &"mirror", &"candle"])
minimum = 3

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2_rule")
id = &"stay_awake"
allowed_any = Array[StringName]([&"lamp", &"mirror", &"candle"])
forbidden_any = Array[StringName]([&"sleep_aid"])
value_requirements = Array[Resource]([SubResource("Value")])

[resource]
script = ExtResource("1_wish")
id = &"wish_stay_awake"
display_name_key = &"slot.wish.stay_awake.name"
slot_rule = SubResource("Rule")
result_text_keys = {&"book_aquarium_issue": &"slot.wish.stay_awake.result.book_aquarium_issue", &"book_bedtime_clipping": &"slot.wish.stay_awake.result.book_bedtime_clipping", &"craft_childhood_teddy": &"slot.wish.stay_awake.result.craft_childhood_teddy", &"craft_clear_receiver": &"slot.wish.stay_awake.result.craft_clear_receiver", &"craft_tide_receiver": &"slot.wish.stay_awake.result.craft_tide_receiver", &"flower_night_jasmine": &"slot.wish.stay_awake.result.flower_night_jasmine", &"flower_sunflower": &"slot.wish.stay_awake.result.flower_sunflower", &"record_fluorescent_single": &"slot.wish.stay_awake.result.record_fluorescent_single", &"toy_glass_marble": &"slot.wish.stay_awake.result.toy_glass_marble", &"toy_windup_moth": &"slot.wish.stay_awake.result.toy_windup_moth"}
