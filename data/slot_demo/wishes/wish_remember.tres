[gd_resource type="Resource" script_class="DailyWishDefinition" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/slot_domain/daily_wish_definition.gd" id="1_wish"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/slot_domain/slot_value_requirement.gd" id="3_value"]

[sub_resource type="Resource" id="Value"]
script = ExtResource("3_value")
mode = 1
tags = Array[StringName]([&"memory", &"music", &"toy"])
minimum = 3

[sub_resource type="Resource" id="Rule"]
script = ExtResource("2_rule")
id = &"remember"
allowed_any = Array[StringName]([&"memory", &"music", &"toy"])
forbidden_any = Array[StringName]([&"food"])
value_requirements = Array[Resource]([SubResource("Value")])

[resource]
script = ExtResource("1_wish")
id = &"wish_remember"
display_name_key = &"slot.wish.remember.name"
slot_rule = SubResource("Rule")
result_text_keys = {&"book_bedtime_clipping": &"slot.wish.remember.result.book_bedtime_clipping", &"craft_childhood_teddy": &"slot.wish.remember.result.craft_childhood_teddy", &"craft_clear_receiver": &"slot.wish.remember.result.craft_clear_receiver", &"craft_comfort_bear": &"slot.wish.remember.result.craft_comfort_bear", &"craft_tide_receiver": &"slot.wish.remember.result.craft_tide_receiver", &"record_fluorescent_single": &"slot.wish.remember.result.record_fluorescent_single", &"record_lullaby_cassette": &"slot.wish.remember.result.record_lullaby_cassette", &"toy_glass_marble": &"slot.wish.remember.result.toy_glass_marble", &"toy_windup_moth": &"slot.wish.remember.result.toy_windup_moth"}
