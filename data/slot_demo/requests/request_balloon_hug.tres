[gd_resource type="Resource" script_class="OwnerRequestDefinition" load_steps=4 format=3]

[ext_resource type="Script" path="res://scripts/slot_domain/owner_request_definition.gd" id="1_request"]
[ext_resource type="Script" path="res://scripts/slot_domain/card_slot_rule.gd" id="2_rule"]
[ext_resource type="Script" path="res://scripts/slot_domain/slot_value_requirement.gd" id="3_value"]

[sub_resource type="Resource" id="SoftValue"]
script = ExtResource("3_value")
mode = 0
tags = Array[StringName]([&"soft"])
minimum = 4

[sub_resource type="Resource" id="HugRule"]
script = ExtResource("2_rule")
id = &"hug"
display_name_key = &"slot.request.balloon_hug.slot.hug"
required_all = Array[StringName]([&"teddy"])
allowed_any = Array[StringName]([&"mirror", &"pillow"])
forbidden_any = Array[StringName]([&"lamp", &"candle"])
value_requirements = Array[Resource]([SubResource("SoftValue")])

[resource]
script = ExtResource("1_request")
id = &"request_balloon_hug"
owner_id = &"balloon"
display_name_key = &"slot.request.balloon_hug.name"
unlock_level = 2
slot_rule = SubResource("HugRule")
base_experience = 6
preferred_bonus = 2
preferred_item_ids = Array[StringName]([&"craft_comfort_bear"])
result_text_by_item = {&"craft_childhood_teddy": &"slot.request.balloon_hug.result.memory", &"craft_comfort_bear": &"slot.request.balloon_hug.result.comfort"}
story_flag_key = &"balloon_hug"
story_flag_value_by_item = {&"craft_childhood_teddy": &"memory", &"craft_comfort_bear": &"comfort"}
